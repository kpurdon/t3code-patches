def nightly_repair_merge_enabled(data, thread):
    if not thread:
        return False
    try:
        policy = read_if_present(data / 'nightly-repair-merge.json', {})
    except (OSError, ValueError):
        return False
    return isinstance(policy, dict) and policy.get('thread') == thread


def nightly_repair_merge(args):
    data = Path(args.data_dir).expanduser().resolve()
    policy = data / 'nightly-repair-merge.json'
    if args.state == 'off':
        policy.unlink(missing_ok=True)
        print('Unattended Nightly repair merges disabled.')
        return
    thread = read_if_present(data / 'nightly-maintenance.json', {}).get('thread')
    if args.state == 'on':
        if not thread:
            raise Stop('Configure a Nightly maintenance thread before enabling unattended repair merges.')
        atomic_json(policy, {'thread': thread})
    state = 'enabled' if nightly_repair_merge_enabled(data, thread) else 'disabled'
    print(f'Unattended Nightly repair merges {state}.')


def deliver_nightly_events(data, status):
    if not status['pendingEvents']:
        return
    target = read_if_present(data / 'nightly-maintenance.json', {}).get('thread')
    if not target:
        return
    t3_home = data / 't3'
    cli = t3_home / 'bin/t3'
    try:
        for event in list(status['pendingEvents']):
            blocked = status.get('blocked') or {}
            repairable = (event['kind'] == 'failure' and event.get('stage') in ('patch', 'checks')
                          and all(blocked.get(key) == event.get(key) for key in ('version', 'stage', 'patch')))
            merge_prompt = MAINTENANCE_DRAFT_HANDOFF
            if repairable and nightly_repair_merge_enabled(data, target):
                merge_prompt = f'{MAINTENANCE_REPAIR_MERGE}\nAuthorized maintenance thread ID: {target}'
            message = (f'{MAINTENANCE_PROMPT}\n{merge_prompt}\n\nInstallation directory: {data}\n'
                       f'Event: {json.dumps(event)}')
            result = subprocess.run(
                [str(cli), 'thread', 'send', '--base-dir', str(t3_home), target, message],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=30, check=False,
            )
            if result.returncode:
                raise Stop('Maintenance thread is unavailable.')
            status['pendingEvents'].pop(0)
            atomic_json(data / 'nightly-status.json', status)
    except (Stop, OSError, subprocess.TimeoutExpired):
        print('Nightly maintenance delivery failed. Pending events will be retried.', file=sys.stderr)


def prune_nightly_artifacts(data, candidate):
    # The launcher holds this lock until it has recorded the process using its artifacts.
    with (data / 'launch.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        manifests = [read_if_present(data / name, {}) for name in ('current.json', 'previous.json', 'running.json')]
        keep_builds = {manifest.get('build', '') for manifest in manifests}
        keep_versions = {build.rsplit('-', 2)[0] for build in keep_builds} | {candidate}
        keep_versions.update(manifest.get('app', {}).get('version') for manifest in manifests)
        build_pattern = re.compile(NIGHTLY_VERSION.pattern + r'-[a-f0-9]{12}-[a-f0-9]{8}')
        for folder in (data / 'builds').glob('*'):
            if (folder.name not in keep_builds and build_pattern.fullmatch(folder.name)
                    and not folder.is_symlink() and (folder / 'inject.cjs').is_file()):
                shutil.rmtree(folder)
        for folder in (data / 'apps').glob('*'):
            if (folder.name not in keep_versions and NIGHTLY_VERSION.fullmatch(folder.name)
                    and not folder.is_symlink() and (folder / '.managed-nightly').is_file()):
                shutil.rmtree(folder)


def retain_nightly_artifacts(data, version):
    try:
        prune_nightly_artifacts(data, version)
    except (OSError, ValueError):
        print('Could not remove old Nightly artifacts. The updater will retry.', file=sys.stderr)


def nightly_update(args):
    data = Path(args.data_dir).expanduser().resolve()
    data.mkdir(parents=True, exist_ok=True)
    with (data / 'nightly.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        stage, version, recipe = 'release', None, None
        try:
            version = args.version or latest_nightly()
            if not NIGHTLY_VERSION.fullmatch(version):
                raise Stop('Expected an official Nightly version, without the leading v.')
            recipe = recipe_hash()
            previous = read_if_present(data / 'nightly-status.json', {})
            blocked = previous.get('blocked')
            if (not args.version and blocked and blocked['version'] == version
                    and blocked['stage'] == 'patch' and blocked['recipe'] == recipe):
                deliver_nightly_events(data, previous)
                print(f'Nightly {version} is waiting for a repair to {blocked["patch"]}.', flush=True)
                return
            stage = 'app'
            active = read_if_present(data / 'current.json', {}).get('app', {}).get('version', '')
            if NIGHTLY_VERSION.fullmatch(active):
                order = lambda value: tuple(int(part) for part in re.findall(r'\d+', value))
                if order(version) < order(active):
                    raise Stop(f'Nightly {version} is older than the active build {active}.')
            args.app = nightly_app(data, version)
            stage = 'build'
            build(args)
        except (Stop, OSError, ValueError, KeyError) as error:
            if isinstance(error, PatchFailure):
                stage = 'patch'
            elif isinstance(error, CheckFailure):
                stage = 'checks'
            deliver_nightly_events(data, record_nightly_result(data, version, stage, error, recipe))
            retain_nightly_artifacts(data, version)
            raise
        deliver_nightly_events(data, record_nightly_result(data, version, 'ready'))
        retain_nightly_artifacts(data, version)


def nightly_job(args):
    # Keep the LaunchAgent independent of the user's working checkout. Follow merged patches only.
    cache = Path(args.cache_dir).expanduser().resolve()
    cache.mkdir(parents=True, exist_ok=True)
    data = Path(args.data_dir).expanduser().resolve()
    data.mkdir(parents=True, exist_ok=True)
    recipe = cache / 'nightly-recipe'
    git = ['git', '-c', 'core.hooksPath=' + os.devnull]
    with (cache / 'nightly-job.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            if not recipe.exists():
                with tempfile.TemporaryDirectory(prefix='.recipe-', dir=cache) as temp:
                    checkout = Path(temp) / 'checkout'
                    run([*git, 'clone', '--no-tags', '--single-branch', '--branch', 'main', PATCH_REPOSITORY, checkout])
                    os.replace(checkout, recipe)
            else:
                run([*git, '-C', recipe, 'pull', '--ff-only', '--no-tags', PATCH_REPOSITORY, 'main'])
                if (run([*git, '-C', recipe, 'rev-parse', 'HEAD'], capture=True) !=
                        run([*git, '-C', recipe, 'rev-parse', 'FETCH_HEAD'], capture=True)
                        or run([*git, '-C', recipe, 'status', '--porcelain'], capture=True)):
                    raise Stop('The managed Nightly recipe has local changes.')
        except Stop as error:
            with (data / 'nightly.lock').open('a') as update_lock:
                fcntl.flock(update_lock, fcntl.LOCK_EX)
                deliver_nightly_events(data, record_nightly_result(data, None, 'recipe', error))
            raise
        run([sys.executable, recipe / 't3code-patches', '--data-dir', data, '--cache-dir', cache, 'nightly-update'])


def autoupdate(args):
    domain = f'gui/{os.getuid()}'
    service = domain + '/' + LABEL
    plist = Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')
    if args.maintenance_thread and args.state != 'nightly':
        raise Stop('--maintenance-thread is only available with autoupdate nightly.')
    if args.state == 'off':
        subprocess.run(['launchctl', 'bootout', service], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        plist.unlink(missing_ok=True)
        print('Background patch builds disabled.')
        return
    data = Path(args.data_dir).expanduser().resolve()
    data.mkdir(parents=True, exist_ok=True)
    app = Path(args.app or DEFAULT_APP).expanduser().resolve()
    plist.parent.mkdir(parents=True, exist_ok=True)
    cache = Path(args.cache_dir).expanduser().resolve()
    argv = [sys.executable, str(REPO / 't3code-patches'), '--data-dir', str(data), '--cache-dir', str(cache)]
    config = {'Label': LABEL, 'ProgramArguments': argv,
              'RunAtLoad': True, 'StartInterval': 3600, 'ThrottleInterval': 120,
              'EnvironmentVariables': {'PATH': os.environ.get('PATH', '/usr/bin:/bin')},
              'StandardOutPath': str(data / 'update.log'), 'StandardErrorPath': str(data / 'update.log'),
              'LowPriorityIO': True, 'Nice': 10, 'ProcessType': 'Interactive'}
    if args.state == 'nightly':
        if args.maintenance_thread:
            if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}', args.maintenance_thread):
                raise Stop('Expected a T3 maintenance thread ID.')
            atomic_json(data / 'nightly-maintenance.json', {'thread': args.maintenance_thread})
        argv.append('nightly-job')
    else:
        argv.extend(['--app', str(app), 'update'])
        config['WatchPaths'] = [str(app / 'Contents/Info.plist'), str(app / 'Contents/Resources/app.asar')]
    with plist.open('wb') as f:
        plistlib.dump(config, f)
    subprocess.run(['launchctl', 'bootout', service], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    run(['launchctl', 'enable', service])
    run(['launchctl', 'bootstrap', domain, plist])
    print('Hourly Nightly updates enabled.' if args.state == 'nightly' else 'Hourly patch builds enabled.')


def install_launcher(args):
    app = Path.home() / 'Applications/T3 Code (Patched Beta).app'
    data = Path(args.data_dir).expanduser().resolve()
    current = read_if_present(data / 'current.json', {})
    official_app = args.app or current.get('app', {}).get('app') or DEFAULT_APP
    icon = Path(official_app).expanduser() / 'Contents/Resources/icon.icns'
    if not icon.is_file():
        raise Stop('Official T3 Code icon is missing: ' + str(icon))
    contents = app / 'Contents'
    (contents / 'MacOS').mkdir(parents=True, exist_ok=True)
    (contents / 'Resources').mkdir(exist_ok=True)
    shutil.copy2(icon, contents / 'Resources/icon.icns')
    with (contents / 'Info.plist').open('wb') as f:
        plistlib.dump({'CFBundleName': 'T3 Code (Patched Beta)', 'CFBundleDisplayName': 'T3 Code (Patched Beta)',
                      'CFBundleIdentifier': 'com.kpurdon.t3code-patches', 'CFBundleExecutable': 'launch',
                      'CFBundlePackageType': 'APPL', 'CFBundleVersion': '2',
                      'CFBundleIconFile': 'icon.icns', 'LSApplicationCategoryType': 'public.app-category.developer-tools',
                      'LSUIElement': False}, f)
    command = [sys.executable, str(REPO / 't3code-patches'), '--data-dir', str(data), 'launch']
    script = contents / 'MacOS/launch'
    script.write_text('#!/bin/sh\nexec ' + shlex.join(command) + '\n')
    script.chmod(0o755)
    run([LSREGISTER, '-f', app])
    print('Installed launcher: ' + str(app))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--app')
    parser.add_argument('--data-dir', default=str(DEFAULT_DATA))
    parser.add_argument('--cache-dir', default=str(DEFAULT_CACHE))
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('build', 'update', 'status', 'launch', 'install-launcher'):
        sub.add_parser(name)
    auto = sub.add_parser('autoupdate')
    auto.add_argument('state', choices=('on', 'off', 'nightly'))
    auto.add_argument('--maintenance-thread')
    sub.add_parser('nightly-update').add_argument('--version')
    sub.add_parser('nightly-job')
    sub.add_parser('nightly-repair-merge').add_argument('state', choices=('on', 'off', 'status'))
    args = parser.parse_args()
    if sys.platform != 'darwin':
        raise Stop('The signed-app overlay launcher currently supports macOS only.')
    if args.command in ('build', 'update'):
        data = Path(args.data_dir).expanduser().resolve()
        data.mkdir(parents=True, exist_ok=True)
        args.app = args.app or DEFAULT_APP
        with (data / 'nightly.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            build(args)
    elif args.command == 'nightly-update':
        nightly_update(args)
    elif args.command == 'nightly-job':
        nightly_job(args)
    elif args.command == 'nightly-repair-merge':
        nightly_repair_merge(args)
    elif args.command == 'launch':
        launch(args)
    elif args.command == 'autoupdate':
        autoupdate(args)
    elif args.command == 'install-launcher':
        install_launcher(args)
    else:
        current = Path(args.data_dir).expanduser() / 'current.json'
        if not current.exists():
            print('No patched build is staged. Run build or nightly-update.')
        else:
            value = read_json(current)
            validate_artifact(Path(args.data_dir).expanduser(), value)
            print(f"Ready: {value['app']['version']}, source {value['app']['commit'][:12]}, patch {value['recipe'][:12]}")


if __name__ == '__main__':
    try:
        main()
    except (Stop, OSError, ValueError, KeyError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)

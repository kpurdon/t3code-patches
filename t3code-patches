class Stop(Exception):
    pass


class CheckFailure(Stop):
    pass


class PatchFailure(Stop):
    def __init__(self, patch):
        self.patch = patch
        super().__init__(f'Patch did not apply: {patch}')


def sha256(path):
    h = hashlib.sha256()
    with Path(path).open('rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def read_json(path):
    return json.loads(Path(path).read_text())


def atomic_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.' + uuid.uuid4().hex + '.tmp')
    temporary.write_text(json.dumps(value, indent=2) + '\n')
    os.replace(temporary, path)


def run(argv, *, cwd=None, env=None, capture=False):
    result = subprocess.run(list(map(str, argv)), cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                            text=True, stdout=subprocess.PIPE if capture else None, check=False)
    if result.returncode:
        raise Stop(f'Command failed ({result.returncode}): {shlex.join(list(map(str, argv)))}')
    return result.stdout.strip() if capture else result


class Archive:
    def __init__(self, path):
        self.file = Path(path).open('rb')
        try:
            _, header_size, _, json_size = struct.unpack('<4I', self.file.read(16))
            self.offset = 8 + header_size
            self.tree = json.loads(self.file.read(json_size))
        except BaseException:
            self.file.close()
            raise

    def __enter__(self):
        return self

    def __exit__(self, *args):
        self.file.close()

    @staticmethod
    def walk(tree, prefix=''):
        for name, entry in tree.get('files', {}).items():
            if 'files' in entry:
                yield from Archive.walk(entry, prefix + name + '/')
            else:
                yield prefix + name, entry

    def read(self, key):
        entry = dict(self.walk(self.tree))[key]
        if entry.get('unpacked') or 'link' in entry:
            raise Stop('Expected a packed ASAR file: ' + key)
        self.file.seek(self.offset + int(entry['offset']))
        data = self.file.read(entry['size'])
        if len(data) != entry['size']:
            raise Stop('Truncated ASAR entry: ' + key)
        return data

    def scripts(self, prefix):
        for key, entry in self.walk(self.tree):
            if key.startswith(prefix) and key.endswith(('.js', '.mjs', '.cjs')) and not entry.get('unpacked') and 'link' not in entry:
                yield key, self.read(key)


def electron_fuses(app):
    # Electron's fuse wire lives in the signed framework, not the launcher executable.
    names = ['RunAsNode', 'EnableCookieEncryption', 'EnableNodeOptionsEnvironmentVariable',
             'EnableNodeCliInspectArguments', 'EnableEmbeddedAsarIntegrityValidation', 'OnlyLoadAppFromAsar',
             'LoadBrowserProcessSpecificV8Snapshot', 'GrantFileProtocolExtraPrivileges']
    framework = Path(app) / 'Contents/Frameworks/Electron Framework.framework/Electron Framework'
    data = framework.read_bytes()
    start = data.find(b'dL7pKGdnNz796PbbjQWNKmHXBZaB9tsX')
    if start < 0 or len(data) < start + 34:
        return {}
    start += 32
    if data[start] != 1:
        return {}
    length = data[start + 1]
    wire = data[start + 2:start + 2 + length]
    if len(wire) != length:
        return {}
    return dict(zip(names, wire.decode('ascii', 'replace')))


def inspect_app(app):
    app = Path(app).expanduser().resolve()
    resources = app / 'Contents/Resources'
    if (resources / 'server.asar').exists():
        raise Stop('This loader requires an official app with the combined app.asar archive.')
    try:
        with (app / 'Contents/Info.plist').open('rb') as f:
            info = plistlib.load(f)
        executable = app / 'Contents/MacOS' / info['CFBundleExecutable']
        with Archive(resources / 'app.asar') as archive:
            package = json.loads(archive.read('package.json'))
        fuses = electron_fuses(app)
    except (OSError, ValueError, KeyError, struct.error) as e:
        raise Stop(f'Could not inspect official T3 Code: {app}: {e}') from e
    version, commit = package.get('version', ''), package.get('t3codeCommitHash', '')
    if not (re.fullmatch(r'\d+\.\d+\.\d+(?:-beta[.\w-]*)?', version) or NIGHTLY_VERSION.fullmatch(version)):
        raise Stop(f'Expected an official Beta or Nightly version, got {version!r}.')
    if not re.fullmatch(r'[0-9a-f]{7,40}', commit):
        raise Stop('The official app does not record its exact source commit.')
    for required in ('EnableNodeCliInspectArguments', 'RunAsNode'):
        if fuses.get(required) != '1':
            raise Stop(f'This app does not support {required}; refusing to start it without isolated customization.')
    framework = app / 'Contents/Frameworks/Electron Framework.framework/Electron Framework'
    return {'app': str(app), 'executable': str(executable), 'version': version, 'commit': commit,
            'asarSha256': sha256(resources / 'app.asar'), 'executableSha256': sha256(executable),
            'frameworkSha256': sha256(framework), 'electronFuses': fuses}


def public_config(archive):
    found = {}
    for _, content in archive.scripts('apps/server/dist/client/'):
        for name, target in PUBLIC_CONFIG.items():
            match = re.search(re.escape(name).encode() + rb':\s*([`"\'])([^`"\'\\\n]{1,200})\1', content)
            if match:
                found[target] = match.group(2).decode()
    return found


def validate_checks(raw):
    commands = raw.get('commands')
    if not isinstance(commands, list) or not commands:
        raise Stop('checks.json must specify focused validation commands.')
    for command in commands:
        argv = command.get('argv') if isinstance(command, dict) else None
        cwd = command.get('cwd', '.') if isinstance(command, dict) else None
        if not isinstance(argv, list) or not argv or not all(isinstance(x, str) and x for x in argv):
            raise Stop('Each check needs a nonempty argv array; shell commands are not accepted.')
        if not isinstance(cwd, str) or Path(cwd).is_absolute() or '..' in Path(cwd).parts:
            raise Stop('Check working directories must stay inside the source checkout.')
    markers = raw.get('markers', {})
    if not isinstance(markers, dict) or not all(isinstance(k, str) and k.startswith(PREFIXES) and
            isinstance(v, list) and v and all(isinstance(x, str) and x for x in v) for k, v in markers.items()):
        raise Stop('Bundle markers must name build prefixes and nonempty string arrays.')
    return raw


def recipe_hash():
    files = [REPO / 't3code-patches', REPO / 'checks.json', *sorted((REPO / 'patches').glob('*.patch')),
             *sorted((REPO / 'macos').glob('*'))]
    h = hashlib.sha256()
    for path in files:
        if path.is_file():
            h.update(str(path.relative_to(REPO)).encode() + b'\0' + path.read_bytes())
    return h.hexdigest()


def clean_env(node_bin=None):
    env = {k: v for k, v in os.environ.items() if not k.startswith(('T3CODE_', 'VITE_', 'EXPO_PUBLIC_'))}
    for name in ('ELECTRON_RUN_AS_NODE', 'ELECTRON_NO_ASAR', 'NODE_OPTIONS', 'NODE_ENV'):
        env.pop(name, None)
    if node_bin:
        env['PATH'] = str(node_bin) + os.pathsep + env.get('PATH', '')
    env['COREPACK_ENABLE_DOWNLOAD_PROMPT'] = '0'
    return env


def extract_node(archive, destination):
    # Python 3.9 lacks tarfile's data filter; validate normal and link targets there.
    if getattr(tarfile, 'data_filter', None):
        archive.extractall(destination, filter='data')
        return
    root = destination.resolve()
    for member in archive.getmembers():
        target = (destination / member.name).resolve()
        linked = (target.parent / member.linkname).resolve() if member.issym() else (destination / member.linkname).resolve()
        if not target.is_relative_to(root) or ((member.issym() or member.islnk()) and not linked.is_relative_to(root)):
            raise Stop('Unsafe Node archive entry.')
        if member.isdev() or member.isfifo():
            raise Stop('Unexpected device entry in Node archive.')
    archive.extractall(destination, **({'filter': 'fully_trusted'} if hasattr(tarfile, 'fully_trusted_filter') else {}))


def ensure_node(version, cache):
    if not re.fullmatch(r'\d+\.\d+\.\d+', version):
        raise Stop('Expected an exact Node version in upstream package.json engines.node.')
    current = shutil.which('node')
    if current and run([current, '-p', 'process.versions.node'], capture=True) == version:
        return Path(current).parent
    arch = run(['uname', '-m'], capture=True)
    if arch not in ('arm64', 'x86_64'):
        raise Stop('Unsupported macOS architecture: ' + arch)
    target = f'node-v{version}-darwin-{"arm64" if arch == "arm64" else "x64"}'
    folder = cache / 'node' / target
    if (folder / 'bin/node').is_file():
        return folder / 'bin'
    base = f'https://nodejs.org/dist/v{version}/'
    name = target + '.tar.gz'
    folder.parent.mkdir(parents=True, exist_ok=True)
    with urllib.request.urlopen(base + 'SHASUMS256.txt', timeout=30) as response:
        sums = {line.split()[-1]: line.split()[0] for line in response.read().decode().splitlines() if line.strip()}
    download = folder.parent / name
    with urllib.request.urlopen(base + name, timeout=60) as response, download.open('wb') as output:
        shutil.copyfileobj(response, output)
    if sha256(download) != sums.get(name):
        raise Stop('Node download did not match the published SHA256.')
    with tarfile.open(download) as archive:
        extract_node(archive, folder.parent)
    download.unlink()
    return folder / 'bin'


@contextlib.contextmanager
def source_checkout(cache, commit, version):
    gitdir = cache / 'source.git'
    if not gitdir.exists():
        run(['git', 'clone', '--bare', '--filter=blob:none', UPSTREAM, gitdir])
    if subprocess.run(['git', '--git-dir', str(gitdir), 'cat-file', '-e', commit + '^{commit}'],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
        run(['git', '--git-dir', gitdir, 'fetch', 'origin', 'tag', 'v' + version])
    resolved = run(['git', '--git-dir', gitdir, 'rev-parse', '--verify', commit + '^{commit}'], capture=True)
    if not re.fullmatch(r'[0-9a-f]{40}', resolved) or not resolved.startswith(commit):
        raise Stop('Recorded source revision did not resolve uniquely.')
    path = cache / ('work-' + uuid.uuid4().hex)
    run(['git', '-c', 'core.hooksPath=' + os.devnull, '--git-dir', gitdir, 'worktree', 'add', '--detach', path, resolved])
    try:
        yield path
    finally:
        run(['git', '--git-dir', gitdir, 'worktree', 'remove', '--force', path])


def verify_overlay(overlay, stock, checks, config):
    for required in ('apps/server/dist/bin.mjs', 'apps/server/dist/client/index.html',
                     'apps/desktop/dist-electron/boot.cjs', 'apps/desktop/dist-electron/main.cjs'):
        if not (overlay / required).is_file():
            raise Stop('Build output missing ' + required)
    if stock.read('apps/desktop/dist-electron/boot.cjs') != (overlay / 'apps/desktop/dist-electron/boot.cjs').read_bytes():
        raise Stop('Desktop boot code changed; loading into the signed app is unsafe.')
    for prefix in PREFIXES:
        data = b''.join(p.read_bytes() for p in (overlay / prefix).rglob('*') if p.is_file())
        if prefix.endswith('dist-electron') and b'T3CODE_PROFILE_DIRECTORY' not in data:
            raise Stop('The feature patch must support T3CODE_PROFILE_DIRECTORY for isolated Chromium data.')
        for value in config.values():
            old = b''.join(content for _, content in stock.scripts(prefix + '/') if '/client/' not in _)
            if value.encode() in old and value.encode() not in data:
                raise Stop('Build lost official T3 Connect configuration.')
    for prefix, markers in checks.get('markers', {}).items():
        content = b''.join(p.read_bytes() for p in (overlay / prefix).rglob('*') if p.is_file())
        if any(marker.encode() not in content for marker in markers):
            raise Stop('Build is missing a required feature marker under ' + prefix)
    old_client = b''.join(content for _, content in stock.scripts('apps/server/dist/client/'))
    new_client = b''.join(p.read_bytes() for p in (overlay / 'apps/server/dist/client').rglob('*') if p.is_file())
    if any(v.encode() in old_client and v.encode() not in new_client for v in config.values()):
        raise Stop('Web build lost official T3 Connect configuration.')


def build(args):
    app = inspect_app(args.app)
    data, cache = Path(args.data_dir).expanduser().resolve(), Path(args.cache_dir).expanduser().resolve()
    data.mkdir(parents=True, exist_ok=True)
    cache.mkdir(parents=True, exist_ok=True)
    with (cache / 'build.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        recipe = recipe_hash()
        current_path = data / 'current.json'
        current = read_if_present(current_path, None)
        if current is not None:
            if current['app'] == app and current['recipe'] == recipe:
                validate_artifact(data, current)
                print('Patched build is current.', flush=True)
                return
        patches = sorted((REPO / 'patches').glob('*.patch'))
        if not patches:
            raise Stop('No feature patches found in patches/.')
        checks = validate_checks(read_json(REPO / 'checks.json'))
        build_id = app['version'] + '-' + recipe[:12] + '-' + uuid.uuid4().hex[:8]
        staging = data / 'builds' / ('.staging-' + build_id)
        staging.mkdir(parents=True)
        try:
            run(['codesign', '--verify', '--deep', '--strict', app['app']])
            with source_checkout(cache, app['commit'], app['version']) as source:
                source_commit = run(['git', 'rev-parse', 'HEAD'], cwd=source, capture=True)
                for patch in patches:
                    try:
                        run(['git', '-c', 'core.hooksPath=' + os.devnull, 'apply', '--index', patch], cwd=source)
                    except Stop as error:
                        raise PatchFailure(patch.name) from error
                package = read_json(source / 'package.json')
                env = clean_env(ensure_node(package['engines']['node'], cache))
                manager = package['packageManager'].split('+')[0]
                if not re.fullmatch(r'pnpm@\d+\.\d+\.\d+', manager):
                    raise Stop('Expected an exact upstream pnpm version.')
                run(['npx', '--yes', manager, 'install', '--frozen-lockfile', '--ignore-scripts'], cwd=source, env=env)
                env['PATH'] = str(source / 'node_modules/.bin') + os.pathsep + env['PATH']
                check_env = {**env, 'T3CODE_HOME': str(cache / 'test-t3'),
                             'T3CODE_PROFILE_DIRECTORY': str(cache / 'test-electron'),
                             'PLAYWRIGHT_BROWSERS_PATH': str(cache / 'ms-playwright')}
                for command in checks['commands']:
                    cwd = source / command.get('cwd', '.')
                    command_env = {**check_env, 'PATH': str(cwd / 'node_modules/.bin') + os.pathsep + env['PATH']}
                    try:
                        run(command['argv'], cwd=cwd, env=command_env)
                    except Stop as error:
                        raise CheckFailure(str(error)) from error
                with Archive(Path(app['app']) / 'Contents/Resources/app.asar') as stock:
                    config = public_config(stock)
                env.update(config)
                env['APP_VERSION'] = app['version']
                env['TMPDIR'] = str(cache / 'tmp')
                Path(env['TMPDIR']).mkdir(exist_ok=True)
                for name in ('web', 'server', 'desktop'):
                    p = source / 'apps' / name / 'package.json'
                    value = read_json(p)
                    value['version'] = app['version']
                    p.write_text(json.dumps(value, indent=2) + '\n')
                run(['vp', 'build'], cwd=source / 'apps/web', env=env)
                run(['node', 'scripts/cli.ts', 'build'], cwd=source / 'apps/server', env=env)
                run(['node', 'scripts/apply-web-brand-assets.ts', 'production', 'apps/server/dist/client'], cwd=source, env=env)
                helper = source / 'native/browser-secret/build' / ('arm64' if os.uname().machine == 'arm64' else 'x64') / 't3-browser-secret'
                stock_helper = Path(app['app']) / 'Contents/Resources/browser-secret/t3-browser-secret'
                if stock_helper.exists():
                    helper.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(stock_helper, helper)
                for script in ('build-browser-secret.mjs', 'build-preview-annotation-css.mjs'):
                    run(['node', 'scripts/' + script], cwd=source / 'apps/desktop', env=env)
                run(['vp', 'pack'], cwd=source / 'apps/desktop', env=env)
                overlay = staging / 'overlay'
                for prefix in PREFIXES:
                    if any(p.is_symlink() for p in (source / prefix).rglob('*')):
                        raise Stop('Build output contains symlinks.')
                    shutil.copytree(source / prefix, overlay / prefix)
                with Archive(Path(app['app']) / 'Contents/Resources/app.asar') as stock:
                    verify_overlay(overlay, stock, checks, config)
                for path in (REPO / 'macos').glob('*'):
                    if path.is_file():
                        shutil.copy2(path, staging / path.name)
            if inspect_app(args.app) != app:
                raise Stop('Official app changed during the build; no artifact was activated.')
            hashes = {str(p.relative_to(staging)): sha256(p) for p in staging.rglob('*') if p.is_file()}
            manifest = {'schema': 1, 'build': build_id, 'app': app, 'sourceCommit': source_commit, 'recipe': recipe, 'hashes': hashes}
            destination = staging.with_name(build_id)
            os.replace(staging, destination)
            if NIGHTLY_VERSION.fullmatch(app['version']) and current is not None:
                atomic_json(data / 'previous.json', current)
            atomic_json(current_path, manifest)
            print('Staged patched T3 Code ' + app['version'] + '. Existing sessions were not restarted.', flush=True)
        finally:
            if staging.exists():
                shutil.rmtree(staging)


def validate_artifact(data, manifest):
    if manifest.get('schema') != 1 or not re.fullmatch(r'[\w.-]+', manifest.get('build', '')):
        raise Stop('Invalid staged build manifest.')
    folder = Path(data) / 'builds' / manifest['build']
    required = {'connect.mjs', 'inject.cjs', 'overlay/apps/server/dist/bin.mjs',
                'overlay/apps/server/dist/client/index.html', 'overlay/apps/desktop/dist-electron/boot.cjs',
                'overlay/apps/desktop/dist-electron/main.cjs'}
    if not folder.resolve().is_relative_to((Path(data) / 'builds').resolve()):
        raise Stop('Staged build resolves outside the artifact directory.')
    if any(p.is_symlink() for p in folder.rglob('*')):
        raise Stop('Staged builds cannot contain symlinks.')
    files = {str(p.relative_to(folder)) for p in folder.rglob('*') if p.is_file()}
    if not isinstance(manifest.get('hashes'), dict) or set(manifest['hashes']) != files or not required.issubset(files):
        raise Stop('Staged build file inventory is incomplete or changed.')
    for name, digest in manifest['hashes'].items():
        path = folder / name
        if not path.resolve().is_relative_to(folder.resolve()) or not path.is_file() or sha256(path) != digest:
            raise Stop('Staged build changed or is incomplete: ' + name)
    if inspect_app(manifest['app']['app']) != manifest['app']:
        raise Stop('The official app changed. Rebuild before launching the patched app.')
    return folder


def launch(args):
    data = Path(args.data_dir).expanduser().resolve()
    data.mkdir(parents=True, exist_ok=True)
    with (data / 'launch.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        launch_staged(data)


def launch_staged(data):
    manifest = read_json(data / 'current.json')
    folder = validate_artifact(data, manifest)
    profile, t3home = data / 'electron', data / 't3'
    for path in (profile, t3home):
        path.mkdir(parents=True, exist_ok=True)
    running = data / 'running.json'
    if running.exists():
        old = read_json(running)
        result = subprocess.run(['ps', '-ww', '-p', str(old['pid']), '-o', 'command='], capture_output=True, text=True)
        if (result.returncode == 0 and '--inspect-brk=127.0.0.1:' in result.stdout
                and result.stdout.rstrip().endswith('--user-data-dir=' + str(profile))):
            print('Patched T3 Code is already running; quit and reopen it to load the staged update.'
                  if old.get('build') != manifest['build'] else 'Patched T3 Code is already running; select its existing window.')
            return
    env = clean_env()
    env.update(T3CODE_HOME=str(t3home), T3CODE_PROFILE_DIRECTORY=str(profile), T3CODE_DISABLE_AUTO_UPDATE='true')
    with socket.socket() as probe:
        probe.bind(('127.0.0.1', 0))
        port = probe.getsockname()[1]
    with (data / 'runtime.log').open('a') as log:
        if inspect_app(manifest['app']['app']) != manifest['app']:
            raise Stop('The official app changed before launch; refusing to start it.')
        child = subprocess.Popen([manifest['app']['executable'], f'--inspect-brk=127.0.0.1:{port}',
                                  '--user-data-dir=' + str(profile)], env=env, stdout=log, stderr=log,
                                 start_new_session=True)
        atomic_json(running, {'pid': child.pid, 'build': manifest['build']})
        try:
            result = subprocess.run([manifest['app']['executable'], str(folder / 'connect.mjs'), str(port),
                                     str(folder / 'inject.cjs'), str(folder / 'overlay'), str(child.pid)],
                                    env={**env, 'ELECTRON_RUN_AS_NODE': '1'}, stdout=log, stderr=log, timeout=45)
            if result.returncode:
                raise Stop('Customization did not load; see ' + str(data / 'runtime.log'))
        except BaseException:
            if child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait(timeout=5)
            raise
    print('Opened patched T3 Code with isolated data.')


def get_release_json(url):
    request = urllib.request.Request(url, headers={'User-Agent': 't3code-patches'})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


def latest_nightly():
    pointer = get_release_json(f'{UPSTREAM_RELEASES}/download/update-feed/nightly.json')
    tag = pointer.get('tag_name', '')
    if not isinstance(tag, str) or not tag.startswith('v') or not NIGHTLY_VERSION.fullmatch(tag[1:]):
        raise Stop('The official Nightly feed returned an invalid tag.')
    return tag[1:]


def nightly_app(data, version):
    arch = {'arm64': 'arm64', 'x86_64': 'x64'}.get(os.uname().machine)
    if not arch:
        raise Stop('Unsupported macOS architecture.')
    folder = data / 'apps' / version
    app_name = 'T3 Code (Nightly).app'
    app = folder / app_name
    requirement = ('anchor apple generic and identifier "com.t3tools.t3code" '
                   'and certificate leaf[subject.OU] = "ARK85ZXQ4Z"')

    def verify(candidate):
        run(['/usr/bin/codesign', '--verify', '--deep', '--strict', '-R=' + requirement, candidate])
        if inspect_app(candidate)['version'] != version:
            raise Stop('The signed Nightly does not match the release version.')

    if app.is_dir():
        verify(app)
        return app
    name = f'T3-Code-{version}-{arch}.dmg'
    api = 'https://api.github.com/repos/pingdotgg/t3code/releases/tags'
    release = get_release_json(f'{api}/v{version}')
    asset = next((item for item in release['assets'] if item['name'] == name), {})
    digest = re.fullmatch(r'sha256:([a-f0-9]{64})', asset.get('digest') or '')
    if release.get('tag_name') != f'v{version}' or not digest:
        raise Stop(f'The official release is missing a SHA256 digest for {name}.')
    folder.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='.nightly-', dir=folder.parent) as temp:
        temp = Path(temp)
        image = temp / name
        url = f'{UPSTREAM_RELEASES}/download/v{version}/{name}'
        with urllib.request.urlopen(url, timeout=60) as response, image.open('wb') as output:
            shutil.copyfileobj(response, output)
        if sha256(image) != digest[1]:
            raise Stop(f'Nightly disk image did not match the published SHA256 for {name}.')
        mount = temp / 'mount'
        mount.mkdir()
        candidate = temp / 'app'
        candidate.mkdir()
        run(['/usr/bin/hdiutil', 'attach', '-readonly', '-nobrowse', '-mountpoint', mount, image], capture=True)
        try:
            run(['/usr/bin/ditto', mount / app_name, candidate / app_name])
        finally:
            run(['/usr/bin/hdiutil', 'detach', mount], capture=True)
        verify(candidate / app_name)
        (candidate / '.managed-nightly').touch()
        os.replace(candidate, folder)
    return app


def read_if_present(path, default):
    return read_json(path) if path.exists() else default


def record_nightly_result(data, version, stage, error=None, recipe=None):
    file = data / 'nightly-status.json'
    previous = read_if_present(file, {})
    active = read_if_present(data / 'current.json', {}).get('app', {}).get('version')
    failure = {'version': version, 'stage': stage, 'patch': getattr(error, 'patch', None)}
    blocked = previous.get('blocked')
    if error and stage in ('patch', 'checks'):
        blocked = {**failure, 'recipe': recipe}
    elif not error or (blocked and version not in (None, blocked['version'])):
        blocked = None
    seen = previous.get('reportedFailures', [])
    events = previous.get('pendingEvents', [])
    event = None
    if error and failure not in seen:
        seen.append(failure)
        event = {'kind': 'failure', 'active': active, **failure}
    elif not error and seen:
        event = {'kind': 'recovery', 'active': active, 'version': version}
        seen = []
    if event:
        events.append({'id': uuid.uuid4().hex, **event})
    result = {**failure, 'active': active, 'error': str(error) if error else None,
              'blocked': blocked, 'reportedFailures': seen, 'pendingEvents': events}
    atomic_json(file, result)
    return result



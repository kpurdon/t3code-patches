+                  commandId: yield* commandId,
+                  byOwnAgent: false,
+                });
+              }
+            }),
+          { discard: true },
+        );
+        const stillActive = yield* Effect.forEach(members, needsSettlement);
+        if (stillActive.some(Boolean)) {
+          return yield* Effect.fail(
+            "A thread reopened during settlement. Review the initiative and try again.",
+          );
+        }
+      }).pipe(
+        Effect.mapError(
+          (cause) =>
+            new ServerSettingsError({
+              settingsPath,
+              operation: "settle-initiative",
+              cause,
+            }),
+        ),
+      );
+    }),
+  );
+  return yield* settings.updateSettings({
+    initiativeChange: { action: "delete", id: change.id, expectedThreadIds: change.threadIds },
+  });

diff --git a/scripts/scenarios/initiative-archived.e2e.ts b/scripts/scenarios/initiative-archived.e2e.ts
new file mode 100644
index 00000000..00446a7f
--- /dev/null
+++ b/scripts/scenarios/initiative-archived.e2e.ts
@@ -0,0 +1,40 @@
+import { expect } from "e2e";
+
+import { test, WEB } from "./t3.ts";
+
+test(
+  "Archived initiative members hide without losing membership and return when unarchived",
+  WEB,
+  async ({ t3, app, screen }) => {
+    const project = await t3.project("initiative-archive");
+    await t3.thread({ project, title: "Archive worker", messages: ["first"] });
+    await t3.open();
+    await screen.getByRole("button", "New initiative").tap();
+    await screen.getByLabel("Name").fill("Archive lifecycle");
+    await screen.getByLabel("Project manager").selectOption({ label: "Archive worker" });
+    await screen.getByRole("button", "Save", { exact: true }).tap();
+    await expect(screen.getByRole("heading", "New initiative")).toBeHidden();
+    const worker = screen.getByRole("button", { name: /Archive worker,/ });
+    await worker.secondaryTap();
+    await screen.getByRole("menuitem", "Archive thread", { exact: true }).tap();
+    await expect(worker).toBeHidden();
+    const group = screen.getByRole("button", { name: /^Archive lifecycle:/ });
+    await expect(group).toBeVisible();
+    await app.screenshot("initiative-archived");
+    await expect(screen.getByRole("button", { name: /^Saved session/ })).toBeHidden();
+    await expect(
+      screen.getByRole("button", "Archive lifecycle: No sessions", { exact: true }),
+    ).toBeVisible();
+    await app.open("/");
+    await expect(
+      screen.getByRole("button", "Archive lifecycle: No sessions", { exact: true }),
+    ).toBeVisible();
+    await app.screenshot("initiative-archived-reloaded");
+    await app.open("/settings/archived");
+    await screen.getByRole("button", "Unarchive Archive worker", { exact: true }).tap();
+    await app.open("/");
+    await expect(worker).toBeVisible();
+    await expect(screen.getByRole("button", { name: /^Archive lifecycle:.*idle/ })).toBeVisible();
+    await app.screenshot("initiative-unarchived");
+  },
+);

+import { expect } from "e2e";
+
+import { test, WEB } from "./t3.ts";
+
+test(
+  "Named groups organize threads across projects in the boring sidebar",
+  WEB,
+  async ({ t3, app, browser, screen }) => {
+    const server = await t3.project("jobs-server");
+    const client = await t3.project("jobs-client");
+    await t3.thread({ project: server, title: "Routing", messages: ["first"] });
+    await t3.thread({ project: client, title: "Backfill", messages: ["first"] });
+    await t3.thread({ project: client, title: "Other work", messages: ["first"] });
+    await t3.open();
+
+    await expect(screen.getByRole("button", "New group", { exact: true })).toBeHidden();
+    await app.open("/settings/labs");
+    await screen.getByRole("switch", "Boring sidebar (group by project)", { exact: true }).tap();
+    await app.open("/");
+
+    const openThreadMenu = async (title: string, group = true) => {
+      await expect(screen.getByRole("button", `${title},`, { exact: false })).toBeVisible();
+      await browser.evaluate(
+        `(title) => {
+      const row = [...document.querySelectorAll('[role="button"][data-sidebar-row]')].find(
+        (element) => element.getAttribute('aria-label')?.startsWith(title + ",")
+      );
+      if (!row) throw new Error("Cannot find sidebar row " + title);
+      const rect = row.getBoundingClientRect();
+      row.dispatchEvent(new MouseEvent("contextmenu", {
+        bubbles: true, cancelable: true, clientX: rect.x + 10, clientY: rect.y + 10
+      }));
+    }`,
+        title,
+      );
+      if (group)
+        await screen.getByRole("menuitem", "Thread group", { exact: true }).press("ArrowRight");
+    };
+    const inGroup = (title: string) =>
+      browser.evaluate<boolean, string>(
+        `(title) => {
+      const row = [...document.querySelectorAll('[role="button"][data-sidebar-row]')].find(
+        (element) => element.getAttribute('aria-label')?.startsWith(title + ",")
+      );
+      return row?.getAttribute("data-sidebar-parent")?.includes("named-thread-group") ?? false;
+    }`,
+        title,
+      );
+
+    await openThreadMenu("Routing");
+    await screen.getByRole("menuitem", "New group…", { exact: true }).tap();
+    await screen.getByLabel("Group name").fill("Jobs rollout");
+    await screen.getByRole("button", "Create", { exact: true }).tap();
+    await expect.poll(() => inGroup("Routing")).toBe(true);
+
+    await openThreadMenu("Backfill");
+    await screen.getByRole("menuitem", "Jobs rollout", { exact: true }).tap();
+    await expect.poll(() => inGroup("Backfill")).toBe(true);
+    await expect.poll(() => inGroup("Other work")).toBe(false);
+    await expect(screen.getByTestId("sidebar-project-folder")).toBeVisible();
+    await app.open("/");
+    await expect.poll(() => inGroup("Backfill")).toBe(true);
+    await app.screenshot("named-group-across-projects");
+
+    const folder = screen.getByRole("button", { name: /^Jobs rollout/ });
+    await folder.tap();
+    await expect(screen.getByRole("button", { name: /Routing,/ })).toBeHidden();
+    await folder.tap();
+    await expect(screen.getByRole("button", { name: /Routing,/ })).toBeVisible();
+
+    await openThreadMenu("Routing", false);
+    await screen.getByRole("menuitem", "Settle thread", { exact: true }).tap();
+    await expect(screen.getByRole("button", { name: /Routing,/ })).toBeHidden();
+    await screen.getByRole("button", { name: /^Settled/ }).tap();
+    await openThreadMenu("Routing", false);
+    await screen.getByRole("menuitem", "Un-settle thread", { exact: true }).tap();
+    await expect.poll(() => inGroup("Routing")).toBe(true);
+
+    await screen.getByRole("button", "Manage Jobs rollout", { exact: true }).tap();
+    await screen.getByRole("menuitem", "Rename group…", { exact: true }).tap();
+    await screen.getByLabel("Group name").fill("Launch");
+    await screen.getByRole("button", "Save", { exact: true }).tap();
+    await app.open("/");
+    await expect(screen.getByRole("button", { name: /^Launch/ })).toBeVisible();
+
+    await openThreadMenu("Backfill");
+    await screen.getByRole("menuitem", "Remove from Launch", { exact: true }).tap();
+    await expect.poll(() => inGroup("Backfill")).toBe(false);
+    await screen.getByRole("button", "Manage Launch", { exact: true }).tap();
+    await screen.getByRole("menuitem", "Remove group", { exact: true }).tap();
+    await expect(screen.getByTestId("sidebar-named-thread-group")).toBeHidden();
+    await expect(screen.getByRole("button", { name: /Routing,/ })).toBeVisible();
+
+    await screen.getByRole("button", "New group", { exact: true }).tap();
+    await screen.getByLabel("Group name").fill("Ideas");
+    await screen.getByRole("button", "Create", { exact: true }).tap();
+    await expect(screen.getByRole("button", { name: /^Ideas/ })).toBeVisible();
+  },
+);

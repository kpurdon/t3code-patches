diff --git a/apps/web/src/hooks/useNamedThreadGroupActions.tsx b/apps/web/src/hooks/useNamedThreadGroupActions.tsx
new file mode 100644
index 0000000000..c5d323b879
--- /dev/null
+++ b/apps/web/src/hooks/useNamedThreadGroupActions.tsx
@@ -0,0 +1,174 @@
+import {
+  AuthSettingsWriteScope,
+  type ContextMenuItem,
+  type EnvironmentId,
+  type ScopedThreadRef,
+  type ThreadGroupChange,
+  type ThreadId,
+} from "@t3tools/contracts";
+import { useGT } from "gt-react";
+import { FolderPlusIcon } from "lucide-react";
+import { useState, type MouseEvent } from "react";
+import {
+  namedThreadGroupsIn,
+  ThreadGroupNameDialog,
+  type NamedThreadGroup,
+  type ServerConfigs,
+} from "../components/sidebar/SidebarNamedThreadGroups";
+import { SidebarHeaderIconButton } from "../components/sidebar/SidebarThreadHeader";
+import { contextMenuSourceOf } from "../contextMenuSource";
+import { randomUUID } from "../lib/utils";
+import { readLocalApi } from "../localApi";
+import { appAtomRegistry } from "../rpc/atomRegistry";
+import { environmentServerConfigsAtom, serverEnvironment } from "../state/server";
+import { readEnvironmentScope } from "../state/session";
+import { useAtomCommand } from "../state/use-atom-command";
+
+type Editor = { environmentId: EnvironmentId } & (
+  | { action: "create"; id: string; threadId?: ThreadId }
+  | { action: "rename"; id: string; name: string }
+);
+
+type GroupMenuId =
+  | "thread-group:menu"
+  | "thread-group:new"
+  | `thread-group:assign:${string}`
+  | `thread-group:remove:${string}`;
+
+export function isGroupMenuAction(action: string): action is GroupMenuId {
+  return action.startsWith("thread-group:");
+}
+
+export function useNamedThreadGroupActions(enabled: boolean) {
+  const gt = useGT();
+  const [editor, setEditor] = useState<Editor | null>(null);
+  const updateSettings = useAtomCommand(serverEnvironment.updateSettings, "thread group update");
+
+  const canEdit = (environmentId: EnvironmentId) =>
+    enabled && readEnvironmentScope(environmentId, AuthSettingsWriteScope);
+
+  const updateGroup = async (environmentId: EnvironmentId, change: ThreadGroupChange) =>
+    (await updateSettings({ environmentId, input: { patch: { threadGroupChange: change } } }))
+      ._tag === "Success";
+
+  const menuItem = (ref: ScopedThreadRef): ContextMenuItem<GroupMenuId> | null => {
+    const groups = namedThreadGroupsIn(
+      appAtomRegistry.get(environmentServerConfigsAtom).get(ref.environmentId),
+    );
+    if (!canEdit(ref.environmentId) || groups === null) return null;
+    const children: ContextMenuItem<GroupMenuId>[] = [
+      { id: "thread-group:new", label: gt("New group…") },
+    ];
+    let remove: ContextMenuItem<GroupMenuId> | undefined;
+    for (const [id, group] of Object.entries(groups)) {
+      if (group.memberThreadIds.includes(ref.threadId)) {
+        remove = {
+          id: `thread-group:remove:${id}`,
+          label: gt("Remove from {group}", { group: group.name }),
+          separatorBefore: true,
+        };
+      } else {
+        children.push({ id: `thread-group:assign:${id}`, label: group.name });
+      }
+    }
+    if (remove !== undefined) children.push(remove);
+    return { id: "thread-group:menu", label: gt("Thread group"), icon: "folder", children };
+  };
+
+  const handleThreadMenu = async (action: GroupMenuId, ref: ScopedThreadRef) => {
+    if (!canEdit(ref.environmentId)) return;
+    if (action === "thread-group:new") {
+      setEditor({
+        action: "create",
+        id: randomUUID(),
+        environmentId: ref.environmentId,
+        threadId: ref.threadId,
+      });
+    } else if (action !== "thread-group:menu") {
+      const [, operation, id] = action.split(":");
+      if (id !== undefined && (operation === "assign" || operation === "remove")) {
+        await updateGroup(ref.environmentId, { action: operation, id, threadId: ref.threadId });
+      }
+    }
+  };
+
+  const handleGroupMenu = async (group: NamedThreadGroup, event: MouseEvent) => {
+    event.preventDefault();
+    if (!canEdit(group.environmentId)) return;
+    const api = readLocalApi();
+    if (!api) return;
+    const menu = [
+      { id: "rename", label: gt("Rename group…") },
+      { id: "delete", label: gt("Remove group"), destructive: true },
+    ] as const;
+    const rect = event.currentTarget.getBoundingClientRect();
+    const position =
+      event.type === "contextmenu" && contextMenuSourceOf(event) === "mouse"
+        ? { x: event.clientX, y: event.clientY }
+        : { x: rect.left, y: rect.bottom };
+    const choice = await api.contextMenu.show(menu, position, contextMenuSourceOf(event));
+    if (choice === "rename") setEditor({ ...group, action: "rename" });
+    if (choice === "delete")
+      await updateGroup(group.environmentId, { action: "delete", id: group.id });
+  };
+
+  const createButton = (
+    configs: ServerConfigs,
+    labels: ReadonlyMap<EnvironmentId, string | null>,
+  ) => {
+    const environments = [...configs.keys()].filter(
+      (environmentId) =>
+        canEdit(environmentId) && namedThreadGroupsIn(configs.get(environmentId)) !== null,
+    );
+    if (environments.length === 0) return null;
+    return (
+      <SidebarHeaderIconButton
+        label={gt("New group")}
+        onClick={async (event) => {
+          let environmentId = environments[0];
+          if (environments.length > 1) {
+            const rect = event.currentTarget.getBoundingClientRect();
+            environmentId =
+              (await readLocalApi()?.contextMenu.show(
+                environments.map((id) => ({ id, label: labels.get(id) ?? gt("Local") })),
+                { x: rect.left, y: rect.bottom },
+                contextMenuSourceOf(event),
+              )) ?? undefined;
+          }
+          if (environmentId !== undefined)
+            setEditor({ action: "create", id: randomUUID(), environmentId });
+        }}
+      >
+        <FolderPlusIcon />
+      </SidebarHeaderIconButton>
+    );
+  };
+
+  return {
+    menuItem,
+    handleThreadMenu,
+    handleGroupMenu,
+    canEdit,
+    createButton,
+    dialog:
+      enabled && editor !== null ? (
+        <ThreadGroupNameDialog
+          key={editor.id}
+          initialName={editor.action === "rename" ? editor.name : null}
+          onClose={() => setEditor(null)}
+          onSave={async (name) => {
+            const change: ThreadGroupChange =
+              editor.action === "rename"
+                ? { action: "rename", id: editor.id, name }
+                : {
+                    action: "create",
+                    id: editor.id,
+                    name,
+                    ...(editor.threadId === undefined ? {} : { threadId: editor.threadId }),
+                  };
+            if (await updateGroup(editor.environmentId, change)) setEditor(null);
+          }}
+        />
+      ) : null,
+  };
+}

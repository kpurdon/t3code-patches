new file mode 100644
index 0000000000..cacf91aa86
--- /dev/null
+++ b/apps/web/src/components/sidebar/SidebarNamedThreadGroups.tsx
@@ -0,0 +1,167 @@
+import type { EnvironmentServerConfig } from "@t3tools/client-runtime/connection";
+import { scopedThreadKey, scopeThreadRef } from "@t3tools/client-runtime/environment";
+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import type { EnvironmentId, ThreadGroups, ThreadId } from "@t3tools/contracts";
+import { useGT } from "gt-react";
+import { EllipsisIcon, FolderIcon } from "lucide-react";
+import { useId, useState, type MouseEvent } from "react";
+import { Button } from "../ui/button";
+import {
+  Dialog,
+  DialogFooter,
+  DialogHeader,
+  DialogPanel,
+  DialogPopup,
+  DialogTitle,
+} from "../ui/dialog";
+import { Input } from "../ui/input";
+import { Label } from "../ui/label";
+import { SidebarFolderHeader, sidebarFolderRowId } from "./SidebarProjectFolderHeader";
+
+export type ServerConfigs = ReadonlyMap<EnvironmentId, EnvironmentServerConfig>;
+
+export interface NamedThreadGroup {
+  readonly environmentId: EnvironmentId;
+  readonly id: string;
+  readonly key: string;
+  readonly name: string;
+  readonly members: readonly ThreadId[];
+}
+
+const NO_GROUPS: ThreadGroups = {};
+
+export function namedThreadGroupsIn(
+  config: EnvironmentServerConfig | undefined,
+): ThreadGroups | null {
+  if (config === undefined || config.namedThreadGroups !== true) return null;
+  return config.settings.threadGroups ?? NO_GROUPS;
+}
+
+export function groupNamedSidebarThreads(
+  configs: ServerConfigs,
+  activeThreads: readonly EnvironmentThreadShell[],
+  filtered: boolean,
+) {
+  const groups = new Map<string, { group: NamedThreadGroup; threads: EnvironmentThreadShell[] }>();
+  const membership = new Map<string, string>();
+  for (const [environmentId, config] of configs) {
+    const configuredGroups = namedThreadGroupsIn(config);
+    if (configuredGroups === null) continue;
+    for (const [id, group] of Object.entries(configuredGroups)) {
+      const key = `named-thread-group:${JSON.stringify([environmentId, id])}`;
+      groups.set(key, {
+        group: { environmentId, id, key, name: group.name, members: group.memberThreadIds },
+        threads: [],
+      });
+      for (const threadId of group.memberThreadIds) {
+        membership.set(scopedThreadKey(scopeThreadRef(environmentId, threadId)), key);
+      }
+    }
+  }
+  const projectThreads = activeThreads.filter((thread) => {
+    const key = membership.get(scopedThreadKey(scopeThreadRef(thread.environmentId, thread.id)));
+    if (key === undefined) return true;
+    groups.get(key)!.threads.push(thread);
+    return false;
+  });
+  const folders = [...groups.values()].filter(
+    ({ group, threads }) => !filtered || threads.length > 0 || group.members.length === 0,
+  );
+  return { folders, projectThreads };
+}
+
+export function ThreadGroupNameDialog(props: {
+  initialName: string | null;
+  onClose: () => void;
+  onSave: (name: string) => Promise<void>;
+}) {
+  const gt = useGT();
+  const inputId = useId();
+  const [name, setName] = useState(props.initialName ?? "");
+  const [saving, setSaving] = useState(false);
+  return (
+    <Dialog
+      open
+      onOpenChange={(open) => {
+        if (!open && !saving) props.onClose();
+      }}
+    >
+      <DialogPopup>
+        <DialogHeader>
+          <DialogTitle>
+            {props.initialName !== null ? gt("Rename group") : gt("New group")}
+          </DialogTitle>
+        </DialogHeader>
+        <DialogPanel>
+          <form
+            id={`${inputId}-form`}
+            className="flex flex-col gap-2"
+            onSubmit={async (event) => {
+              event.preventDefault();
+              if (!name.trim() || saving) return;
+              setSaving(true);
+              try {
+                await props.onSave(name.trim());
+              } finally {
+                setSaving(false);
+              }
+            }}
+          >
+            <Label htmlFor={inputId}>{gt("Group name")}</Label>
+            <Input
+              id={inputId}
+              value={name}
+              maxLength={120}
+              onChange={(event) => setName(event.currentTarget.value)}
+              disabled={saving}
+            />
+          </form>
+        </DialogPanel>
+        <DialogFooter>
+          <Button type="button" variant="outline" onClick={props.onClose} disabled={saving}>
+            {gt("Cancel")}
+          </Button>
+          <Button type="submit" form={`${inputId}-form`} disabled={!name.trim() || saving}>
+            {props.initialName !== null ? gt("Save") : gt("Create")}
+          </Button>
+        </DialogFooter>
+      </DialogPopup>
+    </Dialog>
+  );
+}
+
+export function SidebarNamedThreadGroupHeader(props: {
+  group: NamedThreadGroup;
+  collapsed: boolean;
+  hiddenThreads: readonly EnvironmentThreadShell[];
+  onToggle: () => void;
+  onMenu?: ((event: MouseEvent) => void) | undefined;
+}) {
+  const gt = useGT();
+  const rowId = sidebarFolderRowId(props.group.key);
+  return (
+    <SidebarFolderHeader
+      rowId={rowId}
+      testId="sidebar-named-thread-group"
+      name={props.group.name}
+      icon={<FolderIcon className="size-4 shrink-0" aria-hidden />}
+      collapsed={props.collapsed}
+      hiddenThreads={props.hiddenThreads}
+      onToggle={props.onToggle}
+      onContextMenu={props.onMenu}
+      action={
+        props.onMenu === undefined ? undefined : (
+          <Button
+            data-sidebar-action-for={rowId}
+            size="icon-xs"
+            variant="ghost-muted"
+            aria-label={gt("Manage {group}", { group: props.group.name })}
+            onClick={props.onMenu}
+          >
+            <EllipsisIcon aria-hidden />
+          </Button>
+        )
+      }
+    />
+  );
+}

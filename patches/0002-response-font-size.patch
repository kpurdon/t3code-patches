diff --git a/scripts/scenarios/response-font-size.e2e.ts b/scripts/scenarios/response-font-size.e2e.ts
new file mode 100644
index 0000000000..04d88dbd5d
--- /dev/null
+++ b/scripts/scenarios/response-font-size.e2e.ts
@@ -0,0 +1,98 @@
+import { expect } from "e2e";
+
+import { test, WEB } from "./t3.ts";
+
+test(
+  "Response font sizing is opt-in, persists, and falls back to Interface when disabled",
+  WEB,
+  async ({ t3, app, screen, browser }) => {
+    const fontSize = (selector: string) =>
+      browser.evaluate<string | null, string>(
+        `(selector) => {
+        const node = document.querySelector(selector);
+        return node ? getComputedStyle(node).fontSize : null;
+      }`,
+        selector,
+      );
+    const project = await t3.project("response-typography", {
+      "src/math.ts": "export const sum = 1 + 1;\n",
+    });
+    await t3.thread({
+      project,
+      title: "Response typography",
+      messages: ["Show a response"],
+      model: "showcase",
+    });
+    await t3.open();
+    const thread = screen.getByRole("button", { name: /Response typography,/ });
+    await expect(thread).toBeVisible();
+    await thread.tap();
+    await expect(screen.getByText("This turn is a replay.", { exact: false })).toBeVisible();
+    await app.screenshot("response-font-default");
+    await app.open("/settings/appearance");
+    const responseSize = screen.getByRole("combobox", "AI response font size", { exact: true });
+    await expect(responseSize).toBeHidden();
+    await screen.getByRole("combobox", "Interface font size", { exact: true }).tap();
+    await screen.getByRole("option", "18 px", { exact: true }).tap();
+
+    await app.open("/settings/labs");
+    const toggle = screen.getByRole("switch", "Enable response font sizing", { exact: true });
+    await expect(toggle).not.toBeChecked();
+    await toggle.tap();
+    await app.open("/settings/appearance");
+    await expect(responseSize).toBeVisible();
+    await responseSize.tap();
+    await screen.getByRole("option", "22 px", { exact: true }).tap();
+    await expect.poll(() => fontSize('[data-testid="response-font-preview"] p')).toBe("22px");
+    await app.screenshot("response-font-preview");
+    await app.open("/");
+    await thread.tap();
+    const responseStyle = async () => {
+      const [response, user, interfaceSize] = await Promise.all([
+        fontSize('[data-message-role="assistant"] .assistant-response-markdown p'),
+        fontSize(
+          '[data-message-role="user"] .user-message-markdown p, [data-message-role="user"] button[aria-expanded]',
+        ),
+        fontSize("html"),
+      ]);
+      return { response, user, interface: interfaceSize };
+    };
+    await expect
+      .poll(responseStyle)
+      .toEqual({ response: "22px", user: "15.75px", interface: "18px" });
+    await expect
+      .poll(() => fontSize('[data-message-role="assistant"] .assistant-response-markdown td'))
+      .toBe("22px");
+    await app.screenshot("response-font-independent");
+    await screen.getByRole("textbox").fill("Give me another short tour");
+    await screen.getByRole("textbox").press("Enter");
+    await expect
+      .poll(() => fontSize(".assistant-response-markdown[data-streaming] p"))
+      .toBe("22px");
+    await app.screenshot("response-font-streaming");
+    await expect(screen.getByRole("button", "Stop generation")).toBeHidden();
+    await app.open("/settings/appearance");
+    await expect(responseSize).toHaveText("22 px");
+    await app.open("/settings/labs");
+    await toggle.tap();
+    await app.open("/settings/appearance");
+    await expect(responseSize).toBeHidden();
+    await app.open("/");
+    await thread.tap();
+    await expect
+      .poll(responseStyle)
+      .toEqual({ response: "15.75px", user: "15.75px", interface: "18px" });
+    await app.screenshot("response-font-disabled");
+    await app.open("/settings/labs");
+    await expect(toggle).not.toBeChecked();
+    await toggle.tap();
+    await app.open("/settings/appearance");
+    await expect(responseSize).toHaveText("22 px");
+    await screen
+      .getByRole("button", "Reset AI response font size to default", { exact: true })
+      .tap();
+    await expect(responseSize).toHaveText("14 px");
+    await expect.poll(() => fontSize('[data-testid="response-font-preview"] p')).toBe("14px");
+    await app.screenshot("response-font-reset");
+  },
+);

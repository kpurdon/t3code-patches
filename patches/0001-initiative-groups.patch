index 00000000..80e688df
--- /dev/null
+++ b/packages/shared/src/initiatives.test.ts
@@ -0,0 +1,75 @@
+import { describe, expect, it } from "vite-plus/test";
+import { DEFAULT_SERVER_SETTINGS, ThreadId, type Initiatives } from "@t3tools/contracts";
+import { applyInitiativeChange, initiativeForThread } from "./initiatives.ts";
+import { applyServerSettingsPatch } from "./serverSettings.ts";
+const pm = ThreadId.make("pm");
+const api = ThreadId.make("api");
+const ui = ThreadId.make("ui");
+const initial = (): Initiatives =>
+  applyInitiativeChange(
+    {},
+    { action: "create", id: "routing", name: "Routing retirement", coordinatorThreadId: pm },
+  );
+describe("initiative relationships", () => {
+  it("creates a coordinator once and keeps independent additions under serialized settings patches", () => {
+    let settings = { ...DEFAULT_SERVER_SETTINGS, initiatives: initial() };
+    for (const threadId of [api, ui, api])
+      settings = applyServerSettingsPatch(settings, {
+        initiativeChange: { action: "assign", id: "routing", threadId },
+      });
+    expect(settings.initiatives.routing?.memberThreadIds).toEqual([pm, api, ui]);
+    expect(settings.initiatives.routing?.coordinatorThreadId).toBe(pm);
+    expect(initiativeForThread(settings.initiatives, ui)).toBe("routing");
+    expect(initiativeForThread(settings.initiatives, ThreadId.make("outside"))).toBeUndefined();
+  });
+  it("moves only the explicitly selected member and preserves the old group's other members", () => {
+    let groups = applyInitiativeChange(initial(), {
+      action: "assign",
+      id: "routing",
+      threadId: api,
+    });
+    groups = applyInitiativeChange(groups, {
+      action: "create",
+      id: "other",
+      name: "Other initiative",
+      coordinatorThreadId: null,
+    });
+    groups = applyInitiativeChange(groups, { action: "coordinator", id: "other", threadId: pm });
+    expect(groups.routing).toMatchObject({ coordinatorThreadId: null, memberThreadIds: [api] });
+    expect(groups.other).toMatchObject({ coordinatorThreadId: pm, memberThreadIds: [pm] });
+  });
+  it("renames, removes and deletes display relationships without changing unrelated settings", () => {
+    let settings = { ...DEFAULT_SERVER_SETTINGS, initiatives: initial() };
+    const before = settings.providerInstances;
+    settings = applyServerSettingsPatch(settings, {
+      initiativeChange: { action: "rename", id: "routing", name: "New name" },
+    });
+    expect(settings.initiatives.routing?.name).toBe("New name");
+    settings = applyServerSettingsPatch(settings, {
+      initiativeChange: { action: "remove", id: "routing", threadId: pm },
+    });
+    expect(settings.initiatives.routing).toMatchObject({
+      coordinatorThreadId: null,
+      memberThreadIds: [],
+    });
+    settings = applyServerSettingsPatch(settings, {
+      initiativeChange: { action: "delete", id: "routing" },
+    });
+    expect(settings.initiatives).toEqual({});
+    expect(settings.providerInstances).toEqual(before);
+  });
+  it("does not resurrect a deleted group or replace an existing group's identity on retry", () => {
+    const groups = initial();
+    expect(
+      applyInitiativeChange(groups, {
+        action: "create",
+        id: "routing",
+        name: "Conflicting",
+        coordinatorThreadId: null,
+      }),
+    ).toBe(groups);
+    expect(applyInitiativeChange({}, { action: "assign", id: "routing", threadId: api })).toEqual(
+      {},
+    );
+  });
+});
diff --git a/packages/shared/src/initiatives.ts b/packages/shared/src/initiatives.ts
new file mode 100644
index 00000000..eb2e5018
--- /dev/null
+++ b/packages/shared/src/initiatives.ts
@@ -0,0 +1,74 @@
+import type { InitiativeChange, Initiatives, ThreadId } from "@t3tools/contracts";
+
+export function initiativeForThread(
+  initiatives: Initiatives,
+  threadId: ThreadId,
+): string | undefined {
+  return Object.entries(initiatives).find(
+    ([, group]) =>
+      group.coordinatorThreadId === threadId || group.memberThreadIds.includes(threadId),
+  )?.[0];
+}
+
+/** Applied by the settings service under its write lock; each call changes one relationship. */
+export function applyInitiativeChange(current: Initiatives, change: InitiativeChange): Initiatives {
+  const next = { ...current };
+  const group = Object.hasOwn(current, change.id) ? current[change.id] : undefined;
+  if (change.action === "delete") {
+    delete next[change.id];
+    return next;
+  }
+  if (change.action === "create") {
+    if (group !== undefined) return current;
+    next[change.id] = { name: change.name, coordinatorThreadId: null, memberThreadIds: [] };
+    return change.coordinatorThreadId === null
+      ? next
+      : applyInitiativeChange(next, {
+          action: "coordinator",
+          id: change.id,
+          threadId: change.coordinatorThreadId,
+        });
+  }
+  if (group === undefined) return current;
+  if (change.action === "rename") {
+    next[change.id] = { ...group, name: change.name };
+    return next;
+  }
+  if (change.action === "remove") {
+    next[change.id] = {
+      ...group,
+      coordinatorThreadId:
+        group.coordinatorThreadId === change.threadId ? null : group.coordinatorThreadId,
+      memberThreadIds: group.memberThreadIds.filter((id) => id !== change.threadId),
+    };
+    return next;
+  }
+  if (
+    change.action === "assign" &&
+    change.onlyIfUngrouped === true &&
+    initiativeForThread(current, change.threadId) !== undefined
+  )
+    return current;
+  if (change.threadId !== null) {
+    // An explicit move changes display membership, never session lifecycle or management authority.
+    for (const [id, other] of Object.entries(next)) {
+      if (id === change.id) continue;
+      next[id] = {
+        ...other,
+        coordinatorThreadId:
+          other.coordinatorThreadId === change.threadId ? null : other.coordinatorThreadId,
+        memberThreadIds: other.memberThreadIds.filter((member) => member !== change.threadId),
+      };
+    }
+  }
+  next[change.id] = {
+    ...group,
+    coordinatorThreadId:
+      change.action === "coordinator" ? change.threadId : group.coordinatorThreadId,
+    memberThreadIds:
+      change.threadId === null
+        ? group.memberThreadIds
+        : [...new Set([...group.memberThreadIds, change.threadId])],
+  };
+  return next;
+}

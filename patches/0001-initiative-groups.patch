@@ -0,0 +1,79 @@
+import { assert, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import { ThreadId, ServerSettingsError } from "@t3tools/contracts";
+import { ServerSettingsService } from "./serverSettings.ts";
+import { inheritInitiative } from "./initiatives.ts";
+it.effect(
+  "inherits explicit membership across native launches without losing concurrent members",
+  () =>
+    Effect.gen(function* () {
+      const settings = yield* ServerSettingsService;
+      const pm = ThreadId.make("pm");
+      yield* settings.updateSettings({
+        initiativeChange: {
+          action: "create",
+          id: "routing",
+          name: "Routing",
+          coordinatorThreadId: pm,
+        },
+      });
+      const children = [ThreadId.make("api"), ThreadId.make("ui")];
+      const outcomes = yield* Effect.forEach(
+        children,
+        (id) => inheritInitiative(settings, pm, id),
+        { concurrency: "unbounded" },
+      );
+      assert.deepEqual(outcomes, [{ initiativeId: "routing" }, { initiativeId: "routing" }]);
+      assert.deepEqual(
+        new Set((yield* settings.getSettings).initiatives.routing?.memberThreadIds),
+        new Set([pm, ...children]),
+      );
+      yield* settings.updateSettings({
+        initiativeChange: {
+          action: "create",
+          id: "other",
+          name: "Other",
+          coordinatorThreadId: null,
+        },
+      });
+      yield* settings.updateSettings({
+        initiativeChange: { action: "assign", id: "other", threadId: children[0]! },
+      });
+      assert.deepEqual(yield* inheritInitiative(settings, pm, children[0]!), {
+        initiativeId: "other",
+      });
+      assert.deepEqual(
+        yield* inheritInitiative(settings, ThreadId.make("outside"), ThreadId.make("unmanaged")),
+        {},
+      );
+    }).pipe(Effect.provide(ServerSettingsService.layerTest())),
+);
+
+it.effect("reports a repairable display warning without rejecting an accepted launch", () =>
+  Effect.gen(function* () {
+    const settings = yield* ServerSettingsService;
+    const pm = ThreadId.make("pm");
+    yield* settings.updateSettings({
+      initiativeChange: {
+        action: "create",
+        id: "routing",
+        name: "Routing",
+        coordinatorThreadId: pm,
+      },
+    });
+    const failing = {
+      ...settings,
+      updateSettings: () =>
+        Effect.fail(
+          new ServerSettingsError({
+            settingsPath: "/isolated/settings.json",
+            operation: "write-file",
+            cause: "unavailable",
+          }),
+        ),
+    };
+    const result = yield* inheritInitiative(failing, pm, ThreadId.make("accepted"));
+    assert.isTrue("initiativeWarning" in result);
+    assert.deepEqual((yield* settings.getSettings).initiatives.routing?.memberThreadIds, [pm]);
+  }).pipe(Effect.provide(ServerSettingsService.layerTest())),
+);
diff --git a/apps/server/src/initiatives.ts b/apps/server/src/initiatives.ts
new file mode 100644
index 00000000..fbb41f4a
--- /dev/null
+++ b/apps/server/src/initiatives.ts
@@ -0,0 +1,39 @@
+import { OrchestratorMcpFailure, type ThreadId } from "@t3tools/contracts";
+import { initiativeForThread } from "@t3tools/shared/initiatives";
+import * as Effect from "effect/Effect";
+import { ServerSettingsService } from "./serverSettings.ts";
+
+/** Grouping is independently repairable after an accepted launch; never turn it into a false launch failure. */
+export const inheritInitiative = Effect.fn("initiatives.inherit")(function* (
+  settings: ServerSettingsService["Service"],
+  callerId: ThreadId,
+  threadId: ThreadId,
+  options: { readonly isReplay?: boolean } = {},
+) {
+  return yield* Effect.gen(function* () {
+    const current = yield* settings.getSettings;
+    const existingId = initiativeForThread(current.initiatives, threadId);
+    if (existingId !== undefined) return { initiativeId: existingId };
+    if (options.isReplay === true) return {};
+    const initiativeId = initiativeForThread(current.initiatives, callerId);
+    if (initiativeId === undefined) return {};
+    const assigned = yield* settings.updateSettings({
+      initiativeChange: { action: "assign", id: initiativeId, threadId, onlyIfUngrouped: true },
+    });
+    const assignedId = initiativeForThread(assigned.initiatives, threadId);
+    if (assignedId === undefined)
+      return yield* new OrchestratorMcpFailure({
+        code: "orchestration_error",
+        message: "Initiative changed during assignment",
+      });
+    return { initiativeId: assignedId };
+  }).pipe(
+    Effect.match({
+      onSuccess: (result) => result,
+      onFailure: () => ({
+        initiativeWarning:
+          "Thread launched; initiative display assignment failed. Repair that assignment without launching another thread.",
+      }),
+    }),
+  );
+});

+
+  await userEvent.click(page.getByRole("button", { name: /^Other work/ }));
+  await expect.element(row(hidden.title)).not.toBeInTheDocument();
+  await act(() => useThreadSelectionStore.getState().clearSelection());
+  await controlClick(a.title);
+  await shiftClick(flat.title);
+  expect(selected()).toEqual([key(a.id), key(b.id), key(foreign.id), key(flat.id)]);
+  await expect.element(row(foreign.title)).toBeVisible();
+  await userEvent.click(
+    page.getByRole("combobox", { name: "Filter threads by project", exact: true }),
+  );
+  await userEvent.click(page.getByRole("option", { name: "local-repository", exact: true }));
+  await expect.element(row(a.title)).toBeVisible();
+  await expect.element(row(foreign.title)).not.toBeInTheDocument();
+});

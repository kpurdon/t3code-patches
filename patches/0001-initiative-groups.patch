+          name: "Routing",
+          coordinatorThreadId: a.id,
+          memberThreadIds: [a.id, b.id, foreign.id],
+        },
+        other: {
+          name: "Other work",
+          coordinatorThreadId: hidden.id,
+          memberThreadIds: [hidden.id],
+        },
+      },
+    },
+  });
+  await page.viewport(1400, 1100);
+  const router = getRouter(createMemoryHistory({ initialEntries: [`/${ENVIRONMENT_ID}/${a.id}`] }));
+  await router.load();
+  await using _app = await render(<AppRoot router={router} />, { router: false });
+  await expect.element(row(b.title)).toBeVisible();
+  await expect
+    .element(page.getByTestId("sidebar-settled-shelf-toggle"))
+    .toHaveTextContent("Settled0");

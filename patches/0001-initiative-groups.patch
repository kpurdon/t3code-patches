diff --git a/apps/server/src/mcp/toolkits/initiatives.test.ts b/apps/server/src/mcp/toolkits/initiatives.test.ts
new file mode 100644
index 00000000..2c3b8fa6
--- /dev/null
+++ b/apps/server/src/mcp/toolkits/initiatives.test.ts
@@ -0,0 +1,200 @@
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import { expect, it } from "@effect/vitest";
+import { EnvironmentId, ProjectId, ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import { McpSchema, McpServer } from "effect/ai";
+import { vi } from "vite-plus/test";
+
+import * as ThreadManagement from "../../orchestration-v2/ThreadManagementService.ts";
+import * as ThreadSearch from "../../orchestration-v2/ThreadSearch.ts";
+import * as PeerForwarding from "../../peer/PeerForwarding.ts";
+import * as PeerLinkRequests from "../../peer/PeerLinkRequests.ts";
+import * as PeerLinks from "../../peer/PeerLinks.ts";
+import * as ScheduledTaskService from "../../scheduledTasks/ScheduledTaskService.ts";
+import * as ServerSettings from "../../serverSettings.ts";
+import * as McpHttpServer from "../McpHttpServer.ts";
+import * as McpInvocationContext from "../McpInvocationContext.ts";
+import * as McpToolAccessTestkit from "../McpToolAccess.testkit.ts";
+
+const coordinatorId = ThreadId.make("initiative-coordinator");
+const memberId = ThreadId.make("initiative-member");
+const coordinator = McpToolAccessTestkit.liveThreadShell(coordinatorId);
+const member = {
+  ...McpToolAccessTestkit.liveThreadShell(memberId),
+  projectId: ProjectId.make("another-repository"),
+};
+
+const scope = (
+  access: McpInvocationContext.McpClientCaller["access"] = "full-access",
+): McpInvocationContext.McpInvocationScope => ({
+  environmentId: EnvironmentId.make("initiative-environment"),
+  requestNamespace: "client:initiative-test",
+  thread: undefined,
+  client: { sessionId: "initiative-test", label: "Initiative test", access },
+  issuedAt: 0,
+  capabilities: new Set(["orchestration"]),
+});
+
+const client = McpSchema.McpServerClient.of({
+  clientId: 1,
+  protocolVersion: "2025-06-18",
+  clientCapabilities: {},
+  clientInfo: { name: "initiative-test", version: "1" },
+  initializePayload: {
+    protocolVersion: "2025-06-18",
+    capabilities: {},
+    clientInfo: { name: "initiative-test", version: "1" },
+  },
+  getClient: Effect.die("unused"),
+});
+
+const call = (
+  name: "t3_initiative_list" | "t3_initiative_update",
+  args: Record<string, unknown> = {},
+  caller = scope(),
+) =>
+  Effect.gen(function* () {
+    const server = yield* McpServer.McpServer;
+    return yield* server
+      .callTool({ name, arguments: args })
+      .pipe(
+        Effect.provideService(McpInvocationContext.McpInvocationContext, caller),
+        Effect.provideService(McpSchema.McpServerClient, client),
+      );
+  });
+
+const declaredFailure = (result: McpSchema.CallToolResult) => {
+  const text = result.content[0];
+  return result.isError === true && text?.type === "text" ? JSON.parse(text.text) : undefined;
+};
+
+const create = () =>
+  call("t3_initiative_update", {
+    change: {
+      action: "create",
+      id: "routing",
+      name: "Routing",
+      coordinatorThreadId: coordinatorId,
+    },
+  });
+
+const makeHarness = () => {
+  const threads = new Map([
+    [coordinatorId, coordinator],
+    [memberId, member],
+  ]);
+  const dispatch = vi.fn(() => Effect.succeed({ sequence: 1, storedEvents: [] }));
+  const layer = McpHttpServer.layerThreadToolkit.pipe(
+    Layer.provideMerge(McpHttpServer.layerInProcessMcpServer),
+    Layer.provide(ServerSettings.layerTest()),
+    Layer.provide(NodeCrypto.layer),
+    Layer.provide(Layer.mock(ThreadSearch.ThreadSearch)({})),
+    Layer.provide(Layer.mock(ScheduledTaskService.ScheduledTaskService)({})),
+    Layer.provide(Layer.mock(PeerForwarding.PeerForwarding)({})),
+    Layer.provide(Layer.mock(PeerLinkRequests.PeerLinkRequests)({})),
+    Layer.provide(Layer.mock(PeerLinks.PeerLinks)({})),
+    Layer.provide(
+      Layer.mock(ThreadManagement.ThreadManagementService)({
+        getThreadShell: (id) => Effect.succeed(threads.get(id) ?? null),
+        getProjectThreadRecords: ({ threadId }) => {
+          const shell = threads.get(threadId);
+          return shell === undefined
+            ? Effect.die("Unexpected projection lookup for an unknown test thread")
+            : Effect.succeed(McpToolAccessTestkit.idleThreadProjection(shell));
+        },
+        dispatch,
+      }),
+    ),
+  );
+  return { layer, threads, dispatch };
+};
+
+it.effect("creates, lists, and assigns initiative members across projects through MCP", () => {
+  const { layer } = makeHarness();
+  return Effect.gen(function* () {
+    expect((yield* call("t3_initiative_list")).structuredContent).toEqual({});
+    const created = yield* create();
+    expect(created.isError).toBe(false);
+    expect(created.structuredContent).toEqual({
+      routing: {
+        name: "Routing",
+        coordinatorThreadId: coordinatorId,
+        memberThreadIds: [coordinatorId],
+      },
+    });
+    const assigned = yield* call("t3_initiative_update", {
+      change: { action: "assign", id: "routing", threadId: memberId },
+    });
+    expect(assigned.isError).toBe(false);
+    expect(assigned.structuredContent).toEqual({
+      routing: {
+        name: "Routing",
+        coordinatorThreadId: coordinatorId,
+        memberThreadIds: [coordinatorId, memberId],
+      },
+    });
+    expect((yield* call("t3_initiative_list")).structuredContent).toEqual(
+      assigned.structuredContent,
+    );
+  }).pipe(Effect.provide(layer));
+});
+
+it.effect(
+  "allows read-only initiative listing and refuses mutations without changing membership",
+  () => {
+    const { layer } = makeHarness();
+    return Effect.gen(function* () {
+      const created = yield* create();
+      const readOnly = scope("read-only");
+      expect((yield* call("t3_initiative_list", {}, readOnly)).structuredContent).toEqual(
+        created.structuredContent,
+      );
+      const denied = yield* call(
+        "t3_initiative_update",
+        {
+          change: { action: "assign", id: "routing", threadId: memberId },
+        },
+        readOnly,
+      );
+      expect(declaredFailure(denied)).toMatchObject({ code: "capability_denied" });
+      expect((yield* call("t3_initiative_list")).structuredContent).toEqual(
+        created.structuredContent,
+      );
+    }).pipe(Effect.provide(layer));
+  },
+);
+
+it.effect("refuses an unknown member without persisting its ID", () => {
+  const { layer } = makeHarness();
+  return Effect.gen(function* () {
+    const created = yield* create();
+    const refused = yield* call("t3_initiative_update", {
+      change: { action: "assign", id: "routing", threadId: "missing-thread" },
+    });
+    expect(declaredFailure(refused)).toMatchObject({ code: "thread_not_found" });
+    expect((yield* call("t3_initiative_list")).structuredContent).toEqual(
+      created.structuredContent,
+    );
+  }).pipe(Effect.provide(layer));
+});
+
+it.effect("deletes only the initiative and preserves its sessions and lifecycle", () => {
+  const { layer, threads, dispatch } = makeHarness();
+  const before = [...threads.values()].map((thread) => ({ ...thread }));
+  return Effect.gen(function* () {
+    yield* create();
+    const assigned = yield* call("t3_initiative_update", {
+      change: { action: "assign", id: "routing", threadId: memberId },
+    });
+    expect(assigned.isError).toBe(false);
+    const deleted = yield* call("t3_initiative_update", {
+      change: { action: "delete", id: "routing" },
+    });
+    expect(deleted.isError).toBe(false);
+    expect(deleted.structuredContent).toEqual({});
+    expect((yield* call("t3_initiative_list")).structuredContent).toEqual({});
+    expect([...threads.values()]).toEqual(before);
+    expect(dispatch).not.toHaveBeenCalled();
+  }).pipe(Effect.provide(layer));
+});

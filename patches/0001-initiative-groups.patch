+import { expect, it } from "vite-plus/test";
+import { EnvironmentId, ProjectId, ThreadId, type Initiative } from "@t3tools/contracts";
+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import { initiativeMembers, initiativeSummary, initiativeLayout } from "./InitiativeSidebar.logic";
+it("keeps the coordinator first and accounts for every member including unloaded sessions", () => {
+  const id = (value: string) => ThreadId.make(value);
+  const group: Initiative = {
+    name: "Routing",
+    coordinatorThreadId: id("pm"),
+    memberThreadIds: [id("api"), id("pm"), id("ui"), id("old")],
+  };
+  expect(initiativeMembers(group)).toEqual(["pm", "api", "ui", "old"]);
+  const shell = (fields: object) => ({ runtime: null, ...fields }) as EnvironmentThreadShell;
+  const threads = new Map([
+    ["pm", shell({ hasPendingUserInput: true })],
+    ["api", shell({ runtime: { status: "running" } })],
+    ["ui", shell({ settledOverride: "settled" })],
+  ]);
+  expect(initiativeSummary(group, threads)).toBe(
+    "1 needs you · 1 working · 1 idle or done · 1 not loaded",
+  );
+});
+
+it("uses grouped order and scope for ranges while excluding collapsed and unrelated members", () => {
+  const environmentId = EnvironmentId.make("local");
+  const id = (value: string) => ThreadId.make(value);
+  const shell = (name: string, projectId: string) =>
+    ({
+      environmentId,
+      id: id(name),
+      projectId: ProjectId.make(projectId),
+    }) as EnvironmentThreadShell;
+  const a = shell("a", "api");
+  const unrelated = shell("unrelated", "api");
+  const b = shell("b", "ui");
+  const hidden = shell("hidden", "api");
+  const configs = new Map([
+    [
+      environmentId,
+      {
+        initiativeGroups: true,
+        settings: {
+          initiatives: {
+            routing: { name: "Routing", coordinatorThreadId: a.id, memberThreadIds: [a.id, b.id] },
+            other: { name: "Other", coordinatorThreadId: null, memberThreadIds: [hidden.id] },
+          },
+        },
+      },
+    ],
+  ]);
+  const layout = initiativeLayout([a, unrelated, b, hidden], configs, null, [
+    "initiative:local:other",
+  ]);
+  expect(layout.visibleThreads.map((thread) => thread.id)).toEqual([a.id, b.id]);
+  expect(layout.keys.has("local:unrelated")).toBe(false);
+  expect(layout.keys.has("local:hidden")).toBe(true);
+  const scoped = initiativeLayout([a, unrelated, b, hidden], configs, new Set(["local:ui"]), []);
+  expect(scoped.visibleThreads.map((thread) => thread.id)).toEqual([b.id]);
+  expect(scoped.groups[0]?.displayed.coordinatorThreadId).toBeNull();
+  expect(scoped.groups[1]?.hidden).toBe(true);
+});
diff --git a/apps/web/src/components/InitiativeSidebar.logic.ts b/apps/web/src/components/InitiativeSidebar.logic.ts
new file mode 100644
index 00000000..2f725aad
--- /dev/null
+++ b/apps/web/src/components/InitiativeSidebar.logic.ts
@@ -0,0 +1,102 @@
+import type { Initiative, Initiatives, EnvironmentId, ThreadId } from "@t3tools/contracts";
+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import { resolveSidebarThreadStatus } from "./Sidebar.logic";
+
+export function initiativeMembers(group: Initiative): readonly ThreadId[] {
+  return [
+    ...new Set([
+      ...(group.coordinatorThreadId === null ? [] : [group.coordinatorThreadId]),
+      ...group.memberThreadIds,
+    ]),
+  ];
+}
+
+export function initiativeSummary(
+  group: Initiative,
+  threads: ReadonlyMap<string, EnvironmentThreadShell>,
+): string {
+  const counts = { working: 0, attention: 0, failed: 0, waiting: 0, ready: 0, unloaded: 0 };
+  for (const id of initiativeMembers(group)) {
+    const thread = threads.get(id);
+    if (!thread) {
+      counts.unloaded++;
+      continue;
+    }
+    const status = resolveSidebarThreadStatus(thread);
+    if (status === "approval" || status === "input" || status === "request") counts.attention++;
+    else if (status === "working" || status === "preparing") counts.working++;
+    else if (status === "failed" || status === "limited") counts.failed++;
+    else if (status === "waiting") counts.waiting++;
+    else counts.ready++;
+  }
+  return (
+    [
+      [counts.attention, "needs you"],
+      [counts.failed, "failed"],
+      [counts.working, "working"],
+      [counts.waiting, "waiting"],
+      [counts.ready, "idle or done"],
+      [counts.unloaded, "not loaded"],
+    ]
+      .filter(([count]) => count !== 0)
+      .map(([count, label]) => `${count} ${label}`)
+      .join(" · ") || "No sessions"
+  );
+}
+
+export interface InitiativeSidebarGroup {
+  environmentId: EnvironmentId;
+  id: string;
+  group: Initiative;
+  displayed: Initiative;
+  hidden: boolean;
+}
+
+/** One projection for rendering, shelf exclusion, selection and keyboard navigation. */
+export function initiativeLayout(
+  threads: readonly EnvironmentThreadShell[],
+  configs: ReadonlyMap<
+    EnvironmentId,
+    { initiativeGroups?: boolean; settings: { initiatives?: Initiatives } }
+  >,
+  scopedProjectKeys: ReadonlySet<string> | null,
+  collapsed: readonly string[],
+) {
+  const byKey = new Map(threads.map((thread) => [`${thread.environmentId}:${thread.id}`, thread]));
+  const keys = new Set<string>();
+  const visibleThreads: EnvironmentThreadShell[] = [];
+  const memberThreads: EnvironmentThreadShell[] = [];
+  const groups: InitiativeSidebarGroup[] = [];
+  for (const [environmentId, config] of [...configs].sort(([a], [b]) => a.localeCompare(b))) {
+    if (config.initiativeGroups !== true) continue;
+    for (const [id, group] of Object.entries(config.settings.initiatives ?? {})) {
+      const allIds = initiativeMembers(group);
+      for (const threadId of allIds) keys.add(`${environmentId}:${threadId}`);
+      const ids = allIds.filter((threadId) => {
+        const thread = byKey.get(`${environmentId}:${threadId}`);
+        return (
+          scopedProjectKeys === null ||
+          (thread !== undefined && scopedProjectKeys.has(`${environmentId}:${thread.projectId}`))
+        );
+      });
+      const displayed = {
+        ...group,
+        coordinatorThreadId:
+          group.coordinatorThreadId !== null && ids.includes(group.coordinatorThreadId)
+            ? group.coordinatorThreadId
+            : null,
+        memberThreadIds: ids,
+      };
+      const hidden = scopedProjectKeys !== null && ids.length === 0;
+      groups.push({ environmentId, id, group, displayed, hidden });
+      for (const threadId of ids) {
+        const thread = byKey.get(`${environmentId}:${threadId}`);
+        if (thread === undefined) continue;
+        memberThreads.push(thread);
+        if (!hidden && !collapsed.includes(`initiative:${environmentId}:${id}`))
+          visibleThreads.push(thread);
+      }
+    }
+  }
+  return { groups, keys, visibleThreads, memberThreads };
+}
diff --git a/apps/web/src/components/InitiativeSidebar.tsx b/apps/web/src/components/InitiativeSidebar.tsx
new file mode 100644
index 00000000..12cc99cd
--- /dev/null
+++ b/apps/web/src/components/InitiativeSidebar.tsx
@@ -0,0 +1,336 @@
+import { randomUUID } from "../lib/utils";
+import { Fragment, useEffect, useState, type ReactNode } from "react";
+import type { EnvironmentId, Initiative, InitiativeChange, ThreadId } from "@t3tools/contracts";
+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import * as Schema from "effect/Schema";
+import { ChevronDownIcon, EllipsisIcon, PlusIcon } from "lucide-react";
+import { appAtomRegistry } from "../rpc/atomRegistry";
+import { threadFamilies } from "../state/threads";
+import { useEnvironments } from "../state/environments";
+import { useUpdateEnvironmentSettings } from "../hooks/useSettings";
+import { useLocalStorage } from "../hooks/useLocalStorage";
+import { Button } from "./ui/button";
+import { Input } from "./ui/input";
+import {
+  Dialog,
+  DialogPopup,
+  DialogTitle,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogPanel,
+} from "./ui/dialog";
+import { Menu, MenuTrigger, MenuPopup, MenuItem } from "./ui/menu";
+import {
+  initiativeMembers,
+  initiativeSummary,
+  type InitiativeSidebarGroup,
+} from "./InitiativeSidebar.logic";
+
+const collapsedSchema = Schema.Array(Schema.String);
+
+interface GroupRef {
+  environmentId: EnvironmentId;
+  id: string;
+  group: Initiative;
+}
+interface Props {
+  threads: readonly EnvironmentThreadShell[];
+  groups: readonly InitiativeSidebarGroup[];
+  renderThread: (thread: EnvironmentThreadShell, parent: string) => ReactNode;
+  onOpen: (environmentId: EnvironmentId, threadId: ThreadId) => void;
+}
+
+function GroupEditor({
+  target,
+  threads,
+  onClose,
+}: {
+  target: GroupRef;
+  threads: Props["threads"];
+  onClose: () => void;
+}) {
+  const update = useUpdateEnvironmentSettings(target.environmentId);
+  const [name, setName] = useState(target.group.name);
+  const [coordinator, setCoordinator] = useState<string>(target.group.coordinatorThreadId ?? "");
+  const [members, setMembers] = useState(new Set(initiativeMembers(target.group)));
+  const [busy, setBusy] = useState(false);
+  const loaded = threads.filter(
+    (thread) => thread.environmentId === target.environmentId && thread.archivedAt === null,
+  );
+  const loadedIds = new Set(loaded.map((thread) => thread.id));
+  const candidates = [
+    ...loaded,
+    ...initiativeMembers(target.group)
+      .filter((id) => !loadedIds.has(id))
+      .map((id) => ({ id, title: `${id} (saved session)` })),
+  ];
+  const change = (mutation: InitiativeChange) =>
+    new Promise<void>((resolve, reject) =>
+      update(
+        { initiativeChange: mutation },
+        { onSaved: resolve, onFailed: () => reject(new Error("Initiative was not saved")) },
+      ),
+    );
+  const save = async () => {
+    if (!name.trim() || busy) return;
+    setBusy(true);
+    try {
+      if (target.group.name === "")
+        await change({
+          action: "create",
+          id: target.id,
+          name: name.trim(),
+          coordinatorThreadId: null,
+        });
+      else if (name.trim() !== target.group.name)
+        await change({ action: "rename", id: target.id, name: name.trim() });
+      const selected = new Set(members);
+      if (coordinator) selected.add(coordinator as ThreadId);
+      for (const id of initiativeMembers(target.group))
+        if (!selected.has(id)) await change({ action: "remove", id: target.id, threadId: id });
+      for (const id of selected)
+        if (!target.group.memberThreadIds.includes(id))
+          await change({ action: "assign", id: target.id, threadId: id });
+      if (coordinator !== (target.group.coordinatorThreadId ?? ""))
+        await change({
+          action: "coordinator",
+          id: target.id,
+          threadId: coordinator === "" ? null : (coordinator as ThreadId),
+        });
+      onClose();
+    } catch {
+      setBusy(false);
+    }
+  };
+  return (
+    <Dialog
+      open
+      onOpenChange={(open) => {
+        if (!open && !busy) onClose();
+      }}
+    >
+      <DialogPopup>
+        <DialogHeader>
+          <DialogTitle>
+            {target.group.name === "" ? "New initiative" : "Manage initiative"}
+          </DialogTitle>
+          <DialogDescription>
+            Group related work across repositories. Moving a session changes its display group;
+            sessions keep their current state.
+          </DialogDescription>
+        </DialogHeader>
+        <DialogPanel>
+          <label className="mt-4 grid gap-2 text-sm">
+            Name
+            <Input value={name} maxLength={120} onChange={(event) => setName(event.target.value)} />
+          </label>
+          <label className="mt-4 grid gap-2 text-sm">
+            Project manager
+            <select
+              aria-label="Project manager"
+              className="rounded border border-input bg-background p-2"
+              value={coordinator}
+              onChange={(event) => setCoordinator(event.target.value)}
+            >
+              <option value="">No project manager</option>
+              {candidates.map((thread) => (
+                <option key={thread.id} value={thread.id}>
+                  {thread.title}
+                </option>
+              ))}
+            </select>
+          </label>
+          <fieldset className="mt-4 max-h-64 space-y-2 overflow-auto">
+            <legend className="mb-2 text-sm font-medium">Sessions</legend>
+            {candidates.map((thread) => (
+              <label key={thread.id} className="flex items-center gap-2 text-sm">
+                <input
+                  type="checkbox"
+                  checked={members.has(thread.id)}
+                  onChange={(event) =>
+                    setMembers((current) => {
+                      const next = new Set(current);
+                      if (event.target.checked) next.add(thread.id);
+                      else next.delete(thread.id);
+                      return next;
+                    })
+                  }
+                />
+                {thread.title}
+              </label>
+            ))}
+          </fieldset>
+        </DialogPanel>
+        <DialogFooter>
+          <Button variant="outline" disabled={busy} onClick={onClose}>
+            Cancel
+          </Button>
+          <Button disabled={busy || !name.trim()} onClick={() => void save()}>
+            {busy ? "Saving…" : "Save"}
+          </Button>
+        </DialogFooter>
+      </DialogPopup>
+    </Dialog>
+  );
+}
+
+function InitiativeGroup({
+  target,
+  threads,
+  renderThread,
+  onOpen,
+  onManage,
+}: Props & { target: InitiativeSidebarGroup; onManage: () => void }) {
+  const update = useUpdateEnvironmentSettings(target.environmentId);
+  const [collapsed, setCollapsed] = useLocalStorage(
+    "t3code:initiatives:collapsed",
+    [] as readonly string[],
+    collapsedSchema,
+  );
+  const key = `initiative:${target.environmentId}:${target.id}`;
+  const closed = collapsed.includes(key);
+  const byId = new Map(
+    threads
+      .filter((thread) => thread.environmentId === target.environmentId)
+      .map((thread) => [thread.id, thread]),
+  );
+  const ids = initiativeMembers(target.displayed);
+  const membersKey = JSON.stringify(initiativeMembers(target.group));
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- retains explicitly grouped saved sessions in the shared shell registry, including while collapsed
+  useEffect(() => {
+    const releases = (JSON.parse(membersKey) as ThreadId[]).map((id) =>
+      threadFamilies.mount(appAtomRegistry, target.environmentId, id),
+    );
+    return () => {
+      for (const release of releases) release();
+    };
+  }, [target.environmentId, membersKey]);
+  if (target.hidden) return null;
+  return (
+    <li
+      className="mt-3 list-none rounded-lg border border-sidebar-border"
+      data-initiative={target.id}
+    >
+      <div className="flex items-center gap-1 px-2 py-1">
+        <button
+          type="button"
+          data-sidebar-row={key}
+          aria-expanded={!closed}
+          className="min-w-0 flex-1 text-left"
+          onClick={() =>
+            setCollapsed((current) =>
+              closed ? current.filter((item) => item !== key) : [...current, key],
+            )
+          }
+        >
+          <span className="flex items-center gap-2 text-sm font-medium">
+            <ChevronDownIcon className={closed ? "size-3 -rotate-90" : "size-3"} />
+            {target.group.name}
+          </span>
+          <span className="block truncate pl-5 text-xs text-sidebar-muted-foreground">
+            {initiativeSummary(target.displayed, byId)}
+          </span>
+        </button>
+        <Menu>
+          <MenuTrigger
+            render={
+              <Button
+                variant="ghost-muted"
+                size="icon-xs"
+                aria-label={`Manage ${target.group.name}`}
+              />
+            }
+          >
+            <EllipsisIcon />
+          </MenuTrigger>
+          <MenuPopup>
+            <MenuItem onClick={onManage}>Manage initiative</MenuItem>
+            <MenuItem
+              onClick={() => update({ initiativeChange: { action: "delete", id: target.id } })}
+            >
+              Remove group; keep sessions
+            </MenuItem>
+          </MenuPopup>
+        </Menu>
+      </div>
+      {!closed && (
+        <ul className="border-t border-sidebar-border pl-3">
+          {ids.map((id) => {
+            const thread = byId.get(id);
+            return (
+              <Fragment key={id}>
+                {id === target.group.coordinatorThreadId && (
+                  <li className="px-3 pt-2 text-xs font-medium text-sidebar-muted-foreground">
+                    Project manager
+                  </li>
+                )}
+                {thread ? (
+                  renderThread(thread, key)
+                ) : (
+                  <li>
+                    <Button variant="ghost" onClick={() => onOpen(target.environmentId, id)}>
+                      Saved session · {id}
+                    </Button>
+                  </li>
+                )}
+              </Fragment>
+            );
+          })}
+          {ids.length === 0 && (
+            <li className="px-3 py-2 text-xs text-sidebar-muted-foreground">
+              Add a project manager and execution sessions.
+            </li>
+          )}
+        </ul>
+      )}
+    </li>
+  );
+}
+
+export function InitiativeSidebar(props: Props) {
+  const { environments } = useEnvironments();
+  const [editing, setEditing] = useState<GroupRef | null>(null);
+  return (
+    <>
+      {environments
+        .filter((environment) => environment.serverConfig?.initiativeGroups === true)
+        .map((environment) => (
+          <Fragment key={environment.environmentId}>
+            <li className="list-none">
+              <Button
+                variant="ghost-muted"
+                size="sm"
+                onClick={() =>
+                  setEditing({
+                    environmentId: environment.environmentId,
+                    id: randomUUID(),
+                    group: { name: "", coordinatorThreadId: null, memberThreadIds: [] },
+                  })
+                }
+              >
+                <PlusIcon />
+                New initiative{environments.length > 1 ? ` · ${environment.label}` : ""}
+              </Button>
+            </li>
+          </Fragment>
+        ))}
+      {props.groups.map((target) => (
+        <InitiativeGroup
+          key={`${target.environmentId}:${target.id}`}
+          {...props}
+          target={target}
+          onManage={() => setEditing(target)}
+        />
+      ))}
+      {editing !== null && (
+        <GroupEditor
+          key={`${editing.environmentId}:${editing.id}`}
+          target={editing}
+          threads={props.threads}
+          onClose={() => setEditing(null)}
+        />
+      )}
+    </>
+  );
+}

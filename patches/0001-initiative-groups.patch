+import {
+  EnvironmentId,
+  ThreadId,
+  type Initiatives,
+  type InitiativeChange,
+} from "@t3tools/contracts";
+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import { applyInitiativeChange } from "@t3tools/shared/initiatives";
+import "~/index.css";
+import { expect, it, vi } from "vite-plus/test";
+import { page } from "vite-plus/test/browser";
+import { render } from "../../test/render";
+
+const state = vi.hoisted(() => ({
+  initiatives: {} as Initiatives,
+  changes: [] as InitiativeChange[],
+  supported: true,
+  mount: vi.fn(
+    (_registry: unknown, _environmentId: unknown, _threadId: unknown) => () => undefined,
+  ),
+}));
+vi.mock(import("../state/environments"), () => ({
+  useEnvironments: (() => ({
+    environments: [
+      {
+        environmentId: "local",
+        label: "Local",
+        serverConfig: {
+          initiativeGroups: state.supported,
+          settings: { initiatives: state.initiatives },
+        },
+      },
+    ],
+  })) as never,
+}));
+vi.mock(import("../state/threads"), () => ({ threadFamilies: { mount: state.mount } }) as never);
+vi.mock(import("../rpc/atomRegistry"), () => ({ appAtomRegistry: {} }) as never);
+vi.mock(import("../hooks/useSettings"), () => ({
+  useUpdateEnvironmentSettings: (() =>
+    (patch: { initiativeChange: InitiativeChange }, callbacks?: { onSaved?: () => void }) => {
+      state.changes.push(patch.initiativeChange);
+      state.initiatives = applyInitiativeChange(state.initiatives, patch.initiativeChange);
+      callbacks?.onSaved?.();
+    }) as never,
+}));
+import { initiativeLayout } from "./InitiativeSidebar.logic";
+import { InitiativeSidebar } from "./InitiativeSidebar";
+const environmentId = EnvironmentId.make("local");
+const pm = ThreadId.make("pm");
+const api = ThreadId.make("api");
+const threads = [
+  { id: pm, title: "Routing PM", runtime: null, settledOverride: null },
+  { id: api, title: "Routing API", runtime: null, settledOverride: "settled" },
+].map((thread) => ({ ...thread, environmentId, archivedAt: null })) as EnvironmentThreadShell[];
+const view = () => (
+  <ul>
+    <InitiativeSidebar
+      threads={threads}
+      groups={
+        initiativeLayout(
+          threads,
+          new Map([
+            [
+              environmentId,
+              { initiativeGroups: state.supported, settings: { initiatives: state.initiatives } },
+            ],
+          ]),
+          null,
+          [],
+        ).groups
+      }
+      renderThread={(thread) => <li>{thread.title}</li>}
+      onOpen={() => undefined}
+    />
+  </ul>
+);
+function setup() {
+  state.supported = true;
+  state.changes = [];
+  state.mount.mockClear();
+  state.initiatives = {
+    routing: { name: "Routing", coordinatorThreadId: pm, memberThreadIds: [pm, api] },
+  };
+  localStorage.clear();
+}
+it("keeps settled members with the PM, mounts saved rows, and persists collapse", async () => {
+  setup();
+  await using screen = await render(view());
+  await expect.element(screen.getByText("Routing PM")).toBeInTheDocument();
+  await expect.element(screen.getByText("Routing API")).toBeInTheDocument();
+  expect(state.mount.mock.calls.map((call) => call[2])).toEqual([pm, api]);
+  await screen.getByRole("button", { name: /^Routing/ }).click();
+  await expect.element(screen.getByText("Routing PM")).not.toBeInTheDocument();
+  expect(JSON.parse(localStorage.getItem("t3code:initiatives:collapsed")!)).toEqual([
+    "initiative:local:routing",
+  ]);
+  expect(state.changes).toEqual([]);
+});
+it("creates a named group with an explicit PM and settled worker without lifecycle commands", async () => {
+  setup();
+  state.initiatives = {};
+  await using screen = await render(view());
+  await screen.getByRole("button", { name: "New initiative" }).click();
+  await page.getByRole("textbox", { name: "Name" }).fill("Routing");
+  await page.getByRole("combobox", { name: "Project manager" }).selectOptions(pm);
+  await page.getByRole("checkbox", { name: "Routing API" }).click();
+  await page.getByRole("button", { name: "Save", exact: true }).click();
+  await expect.element(page.getByRole("dialog")).not.toBeInTheDocument();
+  await screen.rerender(view());
+  const group = Object.values(state.initiatives)[0]!;
+  expect(group.name).toBe("Routing");
+  expect(group.coordinatorThreadId).toBe(pm);
+  expect(new Set(group.memberThreadIds)).toEqual(new Set([pm, api]));
+  await expect.element(screen.getByText("Routing API")).toBeInTheDocument();
+  expect(threads[1]?.settledOverride).toBe("settled");
+  expect(state.changes.map((change) => change.action)).toEqual([
+    "create",
+    "assign",
+    "assign",
+    "coordinator",
+  ]);
+});
+it("does not expose grouping controls for an unpatched environment", async () => {
+  setup();
+  state.supported = false;
+  await using screen = await render(view());
+  await expect
+    .element(screen.getByRole("button", { name: "New initiative" }))
+    .not.toBeInTheDocument();
+  expect(state.mount).not.toHaveBeenCalled();
+});

diff --git a/apps/web/src/components/NewInitiativeThreadDialog.tsx b/apps/web/src/components/NewInitiativeThreadDialog.tsx
new file mode 100644
index 0000000000..e4f0536f47
--- /dev/null
+++ b/apps/web/src/components/NewInitiativeThreadDialog.tsx
@@ -0,0 +1,309 @@
+import { retainSavedThreadWorkspace } from "../composerDraftStore";
+import { resolveDefaultNewThreadEnvMode } from "../hooks/useHandleNewThread";
+import { resolveNewDraftStartFromOrigin } from "../lib/chatThreadActions";
+import { scopeThreadRef, scopeProjectRef } from "@t3tools/client-runtime/environment";
+import {
+  AuthOrchestrationOperateScope,
+  AuthSettingsWriteScope,
+  CommandId,
+  type ScopedThreadRef,
+  type ThreadId,
+} from "@t3tools/contracts";
+import { resolveProjectSettings } from "@t3tools/shared/projectSettings";
+import { resolveNewThreadModelSelection } from "@t3tools/shared/usageLimits";
+import { LayersIcon } from "lucide-react";
+import * as Schema from "effect/Schema";
+import { useLocalStorage } from "../hooks/useLocalStorage";
+import { useRef, useState } from "react";
+
+import { newThreadId, newDraftId, randomUUID } from "../lib/utils";
+import { resolveProjectDefaultProviderModelSelection } from "../providerInstances";
+import { appAtomRegistry } from "../rpc/atomRegistry";
+import { useProjects } from "../state/entities";
+import { useEnvironments } from "../state/environments";
+import { environmentServerConfigsAtom, serverEnvironment } from "../state/server";
+import {
+  readEnvironmentScope,
+  useEnvironmentScope,
+  useEnvironmentsWithScope,
+} from "../state/session";
+import { threadEnvironment } from "../state/threads";
+import { useAtomCommand } from "../state/use-atom-command";
+import { useOrchestrationCommand } from "../state/use-orchestration-command";
+import type { InitiativeSidebarGroup } from "./InitiativeSidebar.logic";
+import { openInitiativeEditor } from "./initiativeEditor";
+import { SidebarHeaderIconButton } from "./sidebar/SidebarThreadHeader";
+import { Button } from "./ui/button";
+import {
+  Dialog,
+  DialogPopup,
+  DialogHeader,
+  DialogTitle,
+  DialogDescription,
+  DialogPanel,
+  DialogFooter,
+} from "./ui/dialog";
+import { Menu, MenuTrigger, MenuPopup, MenuItem } from "./ui/menu";
+
+const collapsedSchema = Schema.Array(Schema.String);
+
+export function NewInitiativeButton() {
+  const { environments } = useEnvironments();
+  const writable = useEnvironmentsWithScope(environments, AuthSettingsWriteScope);
+  const supported = environments.filter(
+    (environment) =>
+      environment.serverConfig?.initiativeGroups === true &&
+      writable.has(environment.environmentId),
+  );
+  const open = (environmentId: InitiativeSidebarGroup["environmentId"]) =>
+    openInitiativeEditor({
+      environmentId,
+      id: randomUUID(),
+      isNew: true,
+      group: { name: "", coordinatorThreadId: null, memberThreadIds: [] },
+    });
+  if (supported.length === 0) return null;
+  if (supported.length === 1)
+    return (
+      <SidebarHeaderIconButton
+        label="New initiative"
+        onClick={() => open(supported[0]!.environmentId)}
+      >
+        <LayersIcon />
+      </SidebarHeaderIconButton>
+    );
+  return (
+    <Menu>
+      <MenuTrigger render={<SidebarHeaderIconButton label="New initiative" />}>
+        <LayersIcon />
+      </MenuTrigger>
+      <MenuPopup>
+        {supported.map((environment) => (
+          <MenuItem key={environment.environmentId} onClick={() => open(environment.environmentId)}>
+            {environment.label}
+          </MenuItem>
+        ))}
+      </MenuPopup>
+    </Menu>
+  );
+}
+
+export function NewInitiativeThreadDialog({
+  target,
+  onClose,
+  onOpen,
+}: {
+  target: InitiativeSidebarGroup;
+  onClose: () => void;
+  onOpen: (ref: ScopedThreadRef) => void;
+}) {
+  const projects = useProjects().filter(
+    (project) => project.environmentId === target.environmentId && project.archivedAt == null,
+  );
+  const [projectId, setProjectId] = useState("");
+  const selectedProjectId = projectId || projects[0]?.id || "";
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [attempted, setAttempted] = useState(false);
+  const [created, setCreated] = useState<ThreadId | null>(null);
+  const requestId = useRef(newThreadId());
+  const draftId = useRef(newDraftId());
+  const commandId = useRef(CommandId.make(randomUUID()));
+  const [, setCollapsed] = useLocalStorage(
+    "t3code:initiatives:collapsed",
+    [] as readonly string[],
+    collapsedSchema,
+  );
+  const inFlight = useRef(false);
+  const create = useOrchestrationCommand(threadEnvironment.create, { reportFailure: false });
+  const update = useAtomCommand(serverEnvironment.updateSettings, { reportFailure: false });
+  const canWrite = useEnvironmentScope(target.environmentId, AuthSettingsWriteScope);
+  const canOperate = useEnvironmentScope(target.environmentId, AuthOrchestrationOperateScope);
+  const start = async (now: number) => {
+    if (inFlight.current) return;
+    if (
+      !readEnvironmentScope(target.environmentId, AuthSettingsWriteScope) ||
+      !readEnvironmentScope(target.environmentId, AuthOrchestrationOperateScope)
+    ) {
+      setError("This connection cannot create and group threads.");
+      return;
+    }
+    const project = projects.find((item) => item.id === selectedProjectId);
+    const config = appAtomRegistry.get(environmentServerConfigsAtom).get(target.environmentId);
+    if (
+      !project ||
+      config?.initiativeGroups !== true ||
+      !Object.hasOwn(config.settings.initiatives, target.id)
+    ) {
+      setError("This project or initiative is no longer available.");
+      return;
+    }
+    inFlight.current = true;
+    setBusy(true);
+    setError(null);
+    const perform = async () => {
+      if (created === null) {
+        const settings = resolveProjectSettings(config.settings, project.id, project).settings;
+        const selection = resolveNewThreadModelSelection({
+          defaultSelection:
+            settings.defaultModelSelection ??
+            resolveProjectDefaultProviderModelSelection(
+              config.providers,
+              config.settings,
+              project.id,
+            ),
+          fallbackSelection: config.settings.fallbackModelSelection ?? null,
+          providers: config.providers,
+          settings: config.settings,
+          projectId: project.id,
+          now,
+        }).selection;
+        if (!selection) {
+          setError("Configure a provider for this project before creating a thread.");
+          return;
+        }
+        const envMode = await resolveDefaultNewThreadEnvMode(
+          scopeProjectRef(target.environmentId, project.id),
+          project,
+          config.settings,
+          config.newProjectsRoot,
+        );
+        setProjectId(project.id);
+        setAttempted(true);
+        const result = await create({
+          environmentId: target.environmentId,
+          input: {
+            commandId: commandId.current,
+            threadId: requestId.current,
+            projectId: project.id,
+            title: "New thread",
+            modelSelection: selection,
+            runtimeMode: settings.defaultRuntimeMode,
+            interactionMode: "default",
+            branch: null,
+            worktreePath: null,
+          },
+        });
+        if (result._tag === "Failure") {
+          setError("Could not create the thread. Try again.");
+          return;
+        }
+        retainSavedThreadWorkspace(
+          draftId.current,
+          scopeProjectRef(target.environmentId, project.id),
+          requestId.current,
+          {
+            envMode,
+            startFromOrigin: resolveNewDraftStartFromOrigin({
+              envMode,
+              newWorktreesStartFromOrigin: settings.newWorktreesStartFromOrigin,
+            }),
+            runtimeMode: settings.defaultRuntimeMode,
+            interactionMode: "default",
+          },
+        );
+        setCreated(requestId.current);
+      }
+      const assigned = await update({
+        environmentId: target.environmentId,
+        input: {
+          patch: {
+            initiativeChange: { action: "assign", id: target.id, threadId: requestId.current },
+          },
+        },
+      });
+      if (
+        assigned._tag === "Failure" ||
+        !assigned.value.initiatives[target.id]?.memberThreadIds.includes(requestId.current)
+      ) {
+        setError(
+          "The thread was created, but could not be added to this initiative. Retry adding it or open the thread.",
+        );
+        return;
+      }
+      try {
+        setCollapsed((values) =>
+          values.filter((item) => item !== `initiative:${target.environmentId}:${target.id}`),
+        );
+      } catch {
+        /* A local preference must not prevent opening the saved thread. */
+      }
+      onOpen(scopeThreadRef(target.environmentId, requestId.current));
+      onClose();
+    };
+    try {
+      await perform();
+    } catch {
+      setError("Could not finish creating and grouping the thread. Try again.");
+    }
+    inFlight.current = false;
+    setBusy(false);
+  };
+  return (
+    <Dialog
+      open
+      onOpenChange={(open) => {
+        if (!open && !inFlight.current) onClose();
+      }}
+    >
+      <DialogPopup>
+        <DialogHeader>
+          <DialogTitle>New thread in {target.group.name}</DialogTitle>
+          <DialogDescription>
+            Choose a project in this environment. The thread joins this initiative without starting
+            an agent.
+          </DialogDescription>
+        </DialogHeader>
+        <DialogPanel>
+          <label className="grid gap-2 text-sm">
+            Project
+            <select
+              aria-label="Project"
+              value={selectedProjectId}
+              disabled={busy || attempted}
+              onChange={(event) => setProjectId(event.target.value)}
+              className="rounded border border-input bg-background p-2"
+            >
+              {projects.map((project) => (
+                <option key={project.id} value={project.id}>
+                  {project.title}
+                </option>
+              ))}
+            </select>
+          </label>
+          {projects.length === 0 && (
+            <p className="mt-3 text-sm">Add a project to this environment first.</p>
+          )}
+          {error && (
+            <p role="alert" className="mt-3 text-sm">
+              {error}
+            </p>
+          )}
+        </DialogPanel>
+        <DialogFooter>
+          <Button variant="outline" disabled={busy} onClick={onClose}>
+            Cancel
+          </Button>
+          {created !== null && (
+            <Button
+              variant="outline"
+              disabled={busy}
+              onClick={() => {
+                onOpen(scopeThreadRef(target.environmentId, created));
+                onClose();
+              }}
+            >
+              Open thread
+            </Button>
+          )}
+          <Button
+            disabled={busy || !selectedProjectId || !canWrite || !canOperate}
+            onClick={() => void start(Date.now())}
+          >
+            {busy ? "Creating…" : created === null ? "Create thread" : "Retry adding to initiative"}
+          </Button>
+        </DialogFooter>
+      </DialogPopup>
+    </Dialog>
+  );
+}

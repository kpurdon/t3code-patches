index 0000000000..98015a4532
--- /dev/null
+++ b/scripts/scenarios/kp-experience.e2e.ts
@@ -0,0 +1,68 @@
+import { expect } from "e2e";
+
+import { test, WEB } from "./t3.ts";
+
+test(
+  "Initiative management preserves saved initiatives while disabled",
+  WEB,
+  async ({ t3, app, screen, browser }) => {
+    const project = await t3.project("kp-experience");
+    await t3.thread({ project, title: "KP manager", messages: ["first"] });
+    await t3.thread({ project, title: "KP worker", messages: ["first"] });
+    await t3.open();
+    await expect(screen.getByRole("button", "New initiative", { exact: true })).toBeVisible();
+    await app.open("/settings/labs");
+    const toggle = screen.getByRole("switch", "Enable initiative management", { exact: true });
+    await expect(toggle).toBeChecked();
+    await toggle.tap();
+    await expect(toggle).not.toBeChecked();
+    await app.screenshot("kp-labs-disabled");
+    await app.open("/settings/labs");
+    await expect(toggle).not.toBeChecked();
+    await app.open("/");
+    await expect(screen.getByRole("button", "New initiative", { exact: true })).toBeHidden();
+
+    await app.open("/settings/labs");
+    await toggle.tap();
+    await expect(toggle).toBeChecked();
+    await app.screenshot("kp-labs-enabled");
+    await app.open("/");
+    await screen.getByRole("button", "New initiative", { exact: true }).tap();
+    await screen.getByLabel("Name").fill("KP validation");
+    await screen.getByLabel("Project manager").selectOption({ label: "KP manager" });
+    await screen.getByLabel("KP worker").check();
+    await screen.getByRole("button", "Save", { exact: true }).tap();
+    const header = screen.getByRole("button", { name: /^KP validation:/ });
+    await expect(header).toBeVisible();
+    await app.screenshot("kp-initiatives-enabled");
+
+    await app.open("/settings/labs");
+    await toggle.tap();
+    await expect(toggle).not.toBeChecked();
+    await app.open("/");
+    await expect(header).toBeHidden();
+    await expect(screen.getByRole("button", "New initiative", { exact: true })).toBeHidden();
+    const worker = screen.getByRole("button", { name: /KP worker,/ });
+    await expect(worker).toBeVisible();
+    await worker.secondaryTap();
+    await expect(screen.getByRole("menuitem", "Initiatives", { exact: true })).toBeHidden();
+    await browser.keyboard.press("Escape");
+    await app.screenshot("kp-ordinary-sidebar");
+
+    await app.open("/settings/labs");
+    await expect(toggle).not.toBeChecked();
+    await toggle.tap();
+    await app.open("/");
+    await expect(header).toBeVisible();
+    await expect(screen.getByRole("button", { name: /Project manager, KP manager/ })).toBeVisible();
+    await expect(worker).toBeVisible();
+    await worker.secondaryTap();
+    await screen.getByRole("menuitem", "Initiatives", { exact: true }).hover();
+    await expect(
+      screen.getByRole("menuitem", "Remove from KP validation", { exact: true }),
+    ).toBeVisible();
+    await browser.keyboard.press("Escape");
+    await browser.keyboard.press("Escape");
+    await app.screenshot("kp-initiatives-restored");
+  },
+);

diff --git a/scripts/scenarios/initiative-save.e2e.ts b/scripts/scenarios/initiative-save.e2e.ts
new file mode 100644
index 00000000..cc71f9fc
--- /dev/null
+++ b/scripts/scenarios/initiative-save.e2e.ts
@@ -0,0 +1,24 @@
+import { expect } from "e2e";
+
+import { test, WEB } from "./t3.ts";
+
+test(
+  "Saving a PM-only initiative reaches the server and closes the editor",
+  WEB,
+  async ({ t3, app, screen }) => {
+    const project = await t3.project("initiative-demo");
+    await t3.thread({ project, title: "Scenario PM", messages: ["first"] });
+    await t3.open();
+
+    await screen.getByRole("button", "New initiative").tap();
+    await screen.getByLabel("Name").fill("Saved initiative");
+    await screen.getByLabel("Project manager").selectOption({ label: "Scenario PM" });
+    await app.screenshot("initiative-before-save");
+    await screen.getByRole("button", "Save").tap();
+
+    await expect(screen.getByRole("heading", "New initiative")).toBeHidden();
+    await expect(screen.getByText("Saved initiative", { exact: true })).toBeVisible();
+    await expect(screen.getByText("Project manager", { exact: true })).toBeVisible();
+    await app.screenshot("initiative-saved");
+  },
+);

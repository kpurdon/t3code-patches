+it("sizes only assistant prose and headings while preserving code, prompts and interface scaling", () => {
+  const root = document.documentElement;
+  const savedStyle = root.getAttribute("style");
+  const savedFlag = root.hasAttribute("data-response-font-sizing");
+  const host = document.createElement("div");
+  host.innerHTML =
+    '<div class="chat-markdown assistant-response-markdown text-sm leading-relaxed"><h1>Heading</h1><p>Answer <code>inline</code></p><ul><li>Item</li></ul><table><tbody><tr><td>Table text</td></tr></tbody></table><div class="chat-markdown-codeblock"><pre><code>const code = true;</code></pre></div></div><div class="chat-markdown user-message-markdown text-sm"><p>User message</p></div>';
+  document.body.append(host);
+  const size = (selector: string) => getComputedStyle(host.querySelector(selector)!).fontSize;
+  const preferences = {
+    sans: "",
+    code: "",
+    composer: "",
+    sizeInterface: 16,
+    sizePrompt: 14,
+    sizeCode: 13,
+    sizeResponse: 21,
+    responseSizing: false,
+    smoothing: true,
+    separate: true,
+  };
+  try {
+    applyAppearanceFontVariables(root, preferences);
+    expect(size(".assistant-response-markdown p")).toBe("14px");
+    applyAppearanceFontVariables(root, { ...preferences, responseSizing: true });
+    expect(size(".assistant-response-markdown p")).toBe("21px");
+    expect(size(".assistant-response-markdown li")).toBe("21px");
+    expect(size(".assistant-response-markdown td")).toBe("21px");
+    expect(size(".assistant-response-markdown h1")).toBe("30px");
+    expect(size(".assistant-response-markdown p code")).toBe("17.85px");
+    expect(size("pre code")).toBe("13px");
+    expect(getComputedStyle(host.querySelector("pre")!).marginBlock).toBe("0px");
+    expect(size(".user-message-markdown p")).toBe("14px");
+    expect(composerFontSize()).toBe("14px");
+    applyAppearanceFontVariables(root, { ...preferences, responseSizing: true, sizeInterface: 20 });
+    expect(size(".assistant-response-markdown p")).toBe("21px");
+    expect(size(".assistant-response-markdown h1")).toBe("30px");
+    expect(size(".user-message-markdown p")).toBe("17.5px");
+    applyAppearanceFontVariables(root, {
+      ...preferences,
+      responseSizing: false,
+      sizeInterface: 20,
+    });
+    expect(size(".assistant-response-markdown p")).toBe("17.5px");
+    expect(size(".assistant-response-markdown h1")).toBe("25px");
+    expect(root.style.getPropertyValue("--font-size-response")).toBe("");
+  } finally {
+    host.remove();
+    if (savedStyle === null) root.removeAttribute("style");
+    else root.setAttribute("style", savedStyle);
+    root.toggleAttribute("data-response-font-sizing", savedFlag);
+  }
+});

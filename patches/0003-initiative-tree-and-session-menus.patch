+import { AuthSettingsWriteScope, type ScopedThreadRef } from "@t3tools/contracts";
+import { initiativeForThread } from "@t3tools/shared/initiatives";
+import { openInitiativeEditor } from "../components/initiativeEditor";
+import type {
+  ThreadActionMenuId,
+  ThreadActionMenuState,
+} from "../components/threadActionMenu.logic";
+import { toastManager } from "../components/ui/toast";
+import { randomUUID } from "../lib/utils";
+import { appAtomRegistry } from "../rpc/atomRegistry";
+import { readThreadShell } from "../state/entities";
+import { environmentServerConfigsAtom, serverEnvironment } from "../state/server";
+import { readEnvironmentScope } from "../state/session";
+import { useAtomCommand } from "../state/use-atom-command";
+import {
+  isAtomCommandInterrupted,
+  squashAtomCommandFailure,
+} from "@t3tools/client-runtime/state/runtime";
+
+function currentConfig(ref: ScopedThreadRef) {
+  const config = appAtomRegistry.get(environmentServerConfigsAtom).get(ref.environmentId);
+  return config?.initiativeGroups === true &&
+    readEnvironmentScope(ref.environmentId, AuthSettingsWriteScope)
+    ? config
+    : null;
+}
+
+export function useInitiativeThreadActions() {
+  const update = useAtomCommand(serverEnvironment.updateSettings, {
+    label: "initiative membership update",
+    reportFailure: false,
+  });
+  const menuState = (ref: ScopedThreadRef): ThreadActionMenuState["initiative"] => {
+    const config = currentConfig(ref);
+    if (config === null) return undefined;
+    return {
+      currentId: initiativeForThread(config.settings.initiatives, ref.threadId) ?? null,
+      groups: Object.entries(config.settings.initiatives).map(([id, group]) => ({
+        id,
+        name: group.name,
+      })),
+    };
+  };
+  const handle = async (action: ThreadActionMenuId, ref: ScopedThreadRef): Promise<boolean> => {
+    if (!action.startsWith("initiative:")) return false;
+    const config = currentConfig(ref);
+    const thread = readThreadShell(ref);
+    const refuse = (description: string) =>
+      toastManager.add({ type: "error", title: "Initiative action unavailable", description });
+    if (config === null || thread === null || thread.deletedAt !== null) {
+      refuse("This connection cannot change initiative membership for this session.");
+      return true;
+    }
+    if (action === "initiative:start") {
+      openInitiativeEditor({
+        isNew: true,
+        environmentId: ref.environmentId,
+        id: randomUUID(),
+        group: {
+          name: thread.title,
+          coordinatorThreadId: ref.threadId,
+          memberThreadIds: [ref.threadId],
+        },
+      });
+      return true;
+    }
+    const currentId = initiativeForThread(config.settings.initiatives, ref.threadId);
+    const removing = action.startsWith("initiative:remove:");
+    const id = removing
+      ? action.slice("initiative:remove:".length)
+      : action.startsWith("initiative:assign:")
+        ? action.slice("initiative:assign:".length)
+        : undefined;
+    if (
+      id === undefined ||
+      !Object.hasOwn(config.settings.initiatives, id) ||
+      (removing && currentId !== id)
+    ) {
+      refuse("The initiative is no longer available. Open the session menu again.");
+      return true;
+    }
+    const result = await update({
+      environmentId: ref.environmentId,
+      input: {
+        patch: {
+          initiativeChange: removing
+            ? { action: "remove", id, threadId: ref.threadId }
+            : { action: "assign", id, threadId: ref.threadId },
+        },
+      },
+    });
+    if (result._tag === "Failure" && !isAtomCommandInterrupted(result)) {
+      const error = squashAtomCommandFailure(result);
+      refuse(error instanceof Error ? error.message : "The membership change failed. Try again.");
+    }
+    return true;
+  };
+  return { menuState, handle };
+}

diff --git a/apps/web/src/components/initiativeEditor.ts b/apps/web/src/components/initiativeEditor.ts
new file mode 100644
index 00000000..bd84da20
--- /dev/null
+++ b/apps/web/src/components/initiativeEditor.ts
@@ -0,0 +1,23 @@
+import type { EnvironmentId, Initiative } from "@t3tools/contracts";
+import { create } from "zustand";
+
+export interface InitiativeEditorTarget {
+  readonly isNew?: boolean;
+  readonly environmentId: EnvironmentId;
+  readonly id: string;
+  readonly group: Initiative;
+}
+
+const useEditor = create<{ target: InitiativeEditorTarget | null }>(() => ({ target: null }));
+
+export function openInitiativeEditor(target: InitiativeEditorTarget) {
+  useEditor.setState({ target });
+}
+
+export function closeInitiativeEditor() {
+  useEditor.setState({ target: null });
+}
+
+export function useInitiativeEditor() {
+  return useEditor((state) => state.target);
+}

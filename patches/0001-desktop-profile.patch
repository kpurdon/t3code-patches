diff --git a/apps/desktop/src/app/DesktopUserData.test.ts b/apps/desktop/src/app/DesktopUserData.test.ts
index 53e548bd1d..8f7bcc6bc7 100644
--- a/apps/desktop/src/app/DesktopUserData.test.ts
+++ b/apps/desktop/src/app/DesktopUserData.test.ts
@@ -138,3 +138,31 @@ it.effect("retries on the next launch when a GPU cache cannot be removed", () =>
     assert.deepStrictEqual(writes, []);
   }).pipe(Effect.provide(NodeServices.layer)),
 );
+
+it.effect(
+  "uses an explicit absolute profile directory without reading the shared browser profile",
+  () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const directory = yield* fs.makeTempDirectoryScoped({ prefix: "t3-patch-profile-" });
+      const profile = path.join(directory, "isolated");
+      assert.strictEqual(
+        yield* resolveUserDataPath({
+          appDataDirectory: directory,
+          profileDirectory: profile,
+          isDevelopment: false,
+          platform: "darwin",
+        }),
+        profile,
+      );
+      const rejected = yield* resolveUserDataPath({
+        appDataDirectory: directory,
+        profileDirectory: "relative",
+        isDevelopment: false,
+        platform: "darwin",
+      }).pipe(Effect.result);
+      assert.strictEqual(rejected._tag, "Failure");
+      assert.strictEqual(yield* fs.exists(path.join(directory, "t3code-v2")), false);
+    }).pipe(Effect.provide(NodeServices.layer)),
+);

 export const resolveUserDataPath = Effect.fn("desktop.userData.resolveUserDataPath")(
   function* (input: {
     readonly appDataDirectory: string;
+    readonly profileDirectory?: string | null;
     readonly isDevelopment: boolean;
     readonly platform: NodeJS.Platform;
   }) {
     const fs = yield* FileSystem.FileSystem;
     const path = yield* Path.Path;
+    if (input.profileDirectory) {
+      if (!path.isAbsolute(input.profileDirectory))
+        return yield* new DesktopUserDataInitializationError({
+          operation: "inspect",
+          resourcePath: input.profileDirectory,
+          category: "profile directory must be absolute",
+          cause: new Error("Relative profile path refused"),
+        });
+      return input.profileDirectory;
+    }
     const names = input.isDevelopment
       ? { current: "t3code-dev", legacy: "T3 Code (Dev)" }
       : { current: "t3code-v2", legacy: "T3 Code (Alpha)" };
